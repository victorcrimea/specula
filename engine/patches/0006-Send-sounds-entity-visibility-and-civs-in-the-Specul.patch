+// Mirrors the test CCmpSoundManager::PlaySoundGroup makes for the displayed
+// player, for every player at once.
+u16 CSpeculaFeed::Visibility(const CSimContext& context, entity_id_t ent)
+{
+	CmpPtr<ICmpRangeManager> cmpRangeManager(context, SYSTEM_ENTITY);
+	CmpPtr<ICmpPlayerManager> cmpPlayerManager(context, SYSTEM_ENTITY);
+	if (!cmpRangeManager || !cmpPlayerManager)
+		return 0;
+	const player_id_t count = std::min(cmpPlayerManager->GetNumPlayers(), MAX_VISIBILITY_PLAYERS);
+	u16 visibility = 0;
+	for (player_id_t player = 0; player < count; ++player)
+		if (cmpRangeManager->GetLosVisibility(ent, player) == LosVisibility::VISIBLE)
+			visibility |= static_cast<u16>(1 << player);
+	return visibility;
+}
+
+void CSpeculaFeed::RecordEntitySound(const CSimContext& context, const std::wstring& group, entity_id_t ent)
+{
+	if (!g_SoundFeed || ent == INVALID_ENTITY)
+		return;
+	// The engine plays nothing for an entity out of the world.
+	CmpPtr<ICmpPosition> cmpPosition(context, ent);
+	if (!cmpPosition || !cmpPosition->IsInWorld())
+		return;
+	CmpPtr<ICmpOwnership> cmpOwnership(context, ent);
+	const CFixedVector3D position = cmpPosition->GetPosition();
+	g_SoundFeed->m_Sounds.push_back({
+		g_SoundFeed->InternString(utf8_from_wstring(group)),
+		SOUND_ENTITY,
+		ent,
+		cmpOwnership ? cmpOwnership->GetOwner() : INVALID_PLAYER,
+		position.X.GetInternalValue(),
+		position.Y.GetInternalValue(),
+		position.Z.GetInternalValue(),
+		Visibility(context, ent)
+	});
+}
+
+void CSpeculaFeed::RecordPositionSound(const std::wstring& group, const CFixedVector3D& position)
+{
+	if (!g_SoundFeed)
+		return;
+	g_SoundFeed->m_Sounds.push_back({
+		g_SoundFeed->InternString(utf8_from_wstring(group)),
+		SOUND_POSITION,
+		INVALID_ENTITY,
+		INVALID_PLAYER,
+		position.X.GetInternalValue(),
+		position.Y.GetInternalValue(),
+		position.Z.GetInternalValue(),
+		VISIBLE_TO_ALL
+	});
+}
+
+void CSpeculaFeed::RecordPlayerSound(const std::wstring& group, player_id_t player)
+{
+	if (!g_SoundFeed)
+		return;
+	g_SoundFeed->m_Sounds.push_back({
+		g_SoundFeed->InternString(utf8_from_wstring(group)),
+		SOUND_PLAYER,
+		INVALID_ENTITY,
+		player,
+		0, 0, 0,
+		VISIBLE_TO_ALL
+	});
+}
