+		// The session GUI picks its music by this, though it skips the poll
+		// for observers.
+		JS::RootedValue playerID(rq.cx);
+		JS::RootedValue battleState(rq.cx);
+		Script::ToJSVal(rq, &playerID, static_cast<i32>(i));
+		cmpGuiInterface->ScriptCall(INVALID_PLAYER, L"GetBattleState", playerID, &battleState);
+		std::string battle;
+		payload.push_back(battleState.isString() && Script::FromJSVal(rq, battleState, battle) && battle == "BATTLE" ? BATTLE_BATTLE : BATTLE_PEACE);
 	}
 
 	if (payload == m_LastPlayers)
