+// An empty text is no string: an actor or animation that was never set.
+u32 CSpeculaFeed::InternString(const std::string& text)
+{
+	if (text.empty())
+		return NONE;
+	const auto [it, inserted] = m_StringIndices.try_emplace(text, static_cast<u32>(m_StringIndices.size()));
+	if (inserted)
+	{
+		const size_t start = BeginRecord(m_Buffer, RECORD_STRING);
+		PutU32(m_Buffer, it->second);
+		m_Buffer.insert(m_Buffer.end(), text.begin(), text.end());
+		EndRecord(m_Buffer, start);
+	}
+	return it->second;
+}
+
+// A few dozen distinct sets cover a whole match, so each one is sent once
+// and entities refer to it by index. An empty selection selects nothing, so
+// its key is left out like a key never set.
+u32 CSpeculaFeed::InternVariants(const std::map<CStr, CStr>& selections)
+{
+	std::vector<std::pair<u32, u32>> pairs;
+	for (const std::pair<const CStr, CStr>& selection : selections)
+		if (selection.first != ANIMATION_KEY && !selection.second.empty())
+			pairs.emplace_back(InternString(selection.first), InternString(selection.second));
+	if (pairs.empty())
+		return NONE;
+	const auto [it, inserted] = m_VariantSetIndices.try_emplace(pairs, static_cast<u32>(m_VariantSetIndices.size()));
+	if (inserted)
+	{
+		const size_t start = BeginRecord(m_Buffer, RECORD_VARIANT_SET);
+		PutU32(m_Buffer, it->second);
+		PutU32(m_Buffer, static_cast<u32>(pairs.size()));
+		for (const std::pair<u32, u32>& pair : pairs)
+		{
+			PutU32(m_Buffer, pair.first);
+			PutU32(m_Buffer, pair.second);
+		}
+		EndRecord(m_Buffer, start);
+	}
+	return it->second;
+}
