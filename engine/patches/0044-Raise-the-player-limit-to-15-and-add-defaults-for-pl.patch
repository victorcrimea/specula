From c3aa91d25d1290650a5dd651cb1d114b5e56bb69 Mon Sep 17 00:00:00 2001
From: Viktor Semenov <suit.uanic@gmail.com>
Date: Thu, 26 Nov 2026 18:45:04 +0000
Subject: [PATCH 44/45] Raise the player limit to 15 and add defaults for
 players 9 to 15

CCmpRangeManager::m_LosPlayerCounts holds 16 grids indexed by player id, so player 16 aborts the engine.
---
 .../data/mods/public/gui/common/settings.js   |  5 +-
 .../data/settings/player_defaults.json        | 56 +++++++++++++++++++
 2 files changed, 59 insertions(+), 2 deletions(-)

diff --git a/binaries/data/mods/public/gui/common/settings.js b/binaries/data/mods/public/gui/common/settings.js
index 6afcfa3406..4b31f1c06f 100644
--- a/binaries/data/mods/public/gui/common/settings.js
+++ b/binaries/data/mods/public/gui/common/settings.js
@@ -1,8 +1,9 @@
 /**
  * The maximum number of players that the engine supports.
- * TODO: Maybe we can support more than 8 players sometime.
+ * Specula raises it from 8 to 15: CCmpRangeManager::m_LosPlayerCounts holds
+ * 16 grids and is indexed by player id, so player 16 aborts the engine.
  */
-const g_MaxPlayers = 8;
+const g_MaxPlayers = 15;
 
 /**
  * The maximum number of teams allowed.
diff --git a/binaries/data/mods/public/simulation/data/settings/player_defaults.json b/binaries/data/mods/public/simulation/data/settings/player_defaults.json
index 124f90aa00..cdf3af4575 100644
