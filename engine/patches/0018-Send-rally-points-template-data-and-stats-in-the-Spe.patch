+// The rally line helpers below are CCmpRallyPointRenderer's, which builds its
+// path only when the GUI displays a rally point, never in this observer.
+
+// GetClosestsEdgePointFrom: the point of the footprint's outline nearest to
+// target, or the centre without a footprint.
+CFixedVector2D ClosestEdgePoint(const CFixedVector2D& target, CmpPtr<ICmpPosition>& cmpPosition, CmpPtr<ICmpFootprint>& cmpFootprint)
+{
+	const CFixedVector2D center = cmpPosition->GetPosition2D();
+	if (!cmpFootprint)
+		return center;
+	ICmpFootprint::EShape shape;
+	entity_pos_t size0;
+	entity_pos_t size1;
+	entity_pos_t height;
+	cmpFootprint->GetShape(shape, size0, size1, height);
+	if (shape == ICmpFootprint::SQUARE)
+	{
+		fixed s;
+		fixed c;
+		sincos_approx(cmpPosition->GetRotation().Y, s, c);
+		const CFixedVector2D u(c, -s);
+		const CFixedVector2D v(s, c);
+		const CFixedVector2D halfSize(size0 / 2, size1 / 2);
+		return center + Geometry::NearestPointOnSquare(target - center, u, v, halfSize);
+	}
+	CFixedVector2D centerToTarget(target - center);
+	centerToTarget.Normalize();
+	return center + centerToTarget.Multiply(size0);
+}
+
+// ReduceSegmentsByVisibility, floating, as the renderer calls it.
+void ReduceSegmentsByVisibility(const CSimContext& context, std::vector<CVector2D>& coords, unsigned maxSegmentLinks, entity_pos_t lineRadius, pass_class_t passClass)
+{
+	CmpPtr<ICmpPathfinder> cmpPathfinder(context, SYSTEM_ENTITY);
+	CmpPtr<ICmpTerrain> cmpTerrain(context, SYSTEM_ENTITY);
+	CmpPtr<ICmpWaterManager> cmpWaterManager(context, SYSTEM_ENTITY);
+	if (!cmpPathfinder || !cmpTerrain || !cmpWaterManager || coords.size() < 3)
+		return;
+
+	const auto height = [&](const CVector2D& point) {
+		return std::max(cmpTerrain->GetExactGroundLevel(point.X, point.Y), cmpWaterManager->GetExactWaterLevel(point.X, point.Y));
+	};
+	std::vector<CVector2D> newCoords;
+	StationaryOnlyObstructionFilter obstructionFilter;
+	newCoords.push_back(coords[0]);
+	size_t baseNodeIdx = 0;
+	size_t curNodeIdx = 1;
+	entity_pos_t baseNodeX = fixed::FromFloat(coords[baseNodeIdx].X);
+	entity_pos_t baseNodeZ = fixed::FromFloat(coords[baseNodeIdx].Y);
+	float baseNodeY = height(coords[baseNodeIdx]);
+	while (curNodeIdx < coords.size())
+	{
+		const entity_pos_t curNodeX = fixed::FromFloat(coords[curNodeIdx].X);
+		const entity_pos_t curNodeZ = fixed::FromFloat(coords[curNodeIdx].Y);
+		const float curNodeY = height(coords[curNodeIdx]);
+		bool curNodeVisible = cmpPathfinder->CheckMovement(obstructionFilter, baseNodeX, baseNodeZ, curNodeX, curNodeZ, lineRadius, passClass);
+		curNodeVisible = curNodeVisible && fabsf(curNodeY - baseNodeY) < 3.f;
+		if (maxSegmentLinks > 0)
+			curNodeVisible = curNodeVisible && curNodeIdx - baseNodeIdx <= maxSegmentLinks;
+		if (!curNodeVisible)
+		{
+			if (curNodeIdx > baseNodeIdx + 1)
+				baseNodeIdx = curNodeIdx - 1;
+			else
+			{
+				baseNodeIdx = curNodeIdx;
+				++curNodeIdx;
+			}
+			newCoords.push_back(coords[baseNodeIdx]);
+			baseNodeX = fixed::FromFloat(coords[baseNodeIdx].X);
+			baseNodeZ = fixed::FromFloat(coords[baseNodeIdx].Y);
+			baseNodeY = height(coords[baseNodeIdx]);
+		}
+		++curNodeIdx;
+	}
+	newCoords.push_back(coords[coords.size() - 1]);
+	coords.swap(newCoords);
+}
+
+// RecomputeRallyPointPath up to the smoothing: the line to point index, from
+// that point back to the previous one or the footprint's edge.
+std::vector<CVector2D> RallyPath(const CSimContext& context, CmpPtr<ICmpPosition>& cmpPosition, CmpPtr<ICmpFootprint>& cmpFootprint, const std::vector<CFixedVector2D>& points, size_t index, pass_class_t passClass, entity_pos_t lineRadius)
+{
+	std::vector<CVector2D> coords;
+	CmpPtr<ICmpPathfinder> cmpPathfinder(context, SYSTEM_ENTITY);
+	if (!cmpPathfinder)
+		return coords;
+	const CFixedVector2D start = index == 0 ? ClosestEdgePoint(points[0], cmpPosition, cmpFootprint) : points[index - 1];
+	WaypointPath path;
+	std::vector<Waypoint>& waypoints = path.m_Waypoints;
+	PathGoal goal = { PathGoal::POINT, points[index].X, points[index].Y };
+	cmpPathfinder->ComputePathImmediate(start.X, start.Y, goal, passClass, path);
+	if (waypoints.size() < 2)
+	{
+		coords.emplace_back(start.X.ToFloat(), start.Y.ToFloat());
+		coords.emplace_back(points[index].X.ToFloat(), points[index].Y.ToFloat());
+		return coords;
+	}
+	if (index == 0)
+	{
+		const CFixedVector2D beforeEnd(waypoints[waypoints.size() - 2].x, waypoints[waypoints.size() - 2].z);
+		const CFixedVector2D newEnd = ClosestEdgePoint(beforeEnd, cmpPosition, cmpFootprint);
+		waypoints.back().x = newEnd.X;
+		waypoints.back().z = newEnd.Y;
+	}
+	else
+	{
+		waypoints.back().x = points[index - 1].X;
+		waypoints.back().z = points[index - 1].Y;
+	}
+	waypoints[0].x = points[index].X;
+	waypoints[0].z = points[index].Y;
+
+	for (const Waypoint& waypoint : waypoints)
+		coords.emplace_back(waypoint.x.ToFloat(), waypoint.z.ToFloat());
+	for (size_t i = coords.size() - 2; i > 0; --i)
+		coords[i] = (coords[i] + coords[i - 1]) / 2.0f;
+	ReduceSegmentsByVisibility(context, coords, 6, lineRadius, passClass);
+	SimRender::InterpolatePointsRNS(coords, false, 0, 4);
+	return coords;
+}
