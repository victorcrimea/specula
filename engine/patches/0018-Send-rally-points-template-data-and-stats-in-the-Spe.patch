+// Fills the stats slot of every entity: read anew every
+// STATS_INTERVAL_TURNS turns, else as last written. Each distinct JSON goes
+// out once, as a kind 20 record.
+void CSpeculaFeed::PutStats(CSimulation2& simulation, const ScriptRequest& rq, u32 turn, std::unordered_map<entity_id_t, SDetailGroups>& entities)
+{
+	if (m_DetailsTurns != 0 && turn % STATS_INTERVAL_TURNS != 0)
+	{
+		for (std::pair<const entity_id_t, SDetailGroups>& entry : entities)
+		{
+			const auto last = m_LastDetails.find(entry.first);
+			if (last != m_LastDetails.end())
+				entry.second[DETAIL_STATS] = last->second[DETAIL_STATS];
+		}
+		return;
+	}
+	JS::RootedValue reader(rq.cx);
+	if (!simulation.GetScriptInterface().Eval(STATS_SCRIPT, &reader) || !reader.isObject())
+		return;
+	for (std::pair<const entity_id_t, SDetailGroups>& entry : entities)
+	{
+		JS::RootedValue stats(rq.cx);
+		if (!ScriptFunction::Call(rq, reader, "stats", &stats, entry.first) || !stats.isObject())
+			continue;
+		std::string json = Script::StringifyJSON(rq, &stats, false);
+		const auto [it, inserted] = m_StatsIndices.try_emplace(std::move(json), static_cast<u32>(m_StatsIndices.size()));
+		if (inserted)
+		{
+			const size_t start = BeginRecord(m_Buffer, RECORD_STATS);
+			PutU32(m_Buffer, it->second);
+			m_Buffer.insert(m_Buffer.end(), it->first.begin(), it->first.end());
+			EndRecord(m_Buffer, start);
+		}
+		PutU32(entry.second[DETAIL_STATS], it->second);
+	}
+}
