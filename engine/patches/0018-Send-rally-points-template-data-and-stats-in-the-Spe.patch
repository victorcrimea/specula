+const std::vector<u8>& CSpeculaFeed::RallyGroup(CSimulation2& simulation, entity_id_t ent, const std::vector<CFixedVector2D>& points, std::unordered_map<entity_id_t, SRallyGroup>& current)
+{
+	CmpPtr<ICmpPosition> cmpPosition(simulation, ent);
+	CmpPtr<ICmpOwnership> cmpOwnership(simulation, ent);
+	const player_id_t owner = cmpOwnership ? cmpOwnership->GetOwner() : INVALID_PLAYER;
+	const bool placed = cmpPosition && cmpPosition->IsInWorld();
+	std::vector<i32> key = { owner };
+	if (placed)
+	{
+		const CFixedVector2D position = cmpPosition->GetPosition2D();
+		key.insert(key.end(), { position.X.GetInternalValue(), position.Y.GetInternalValue(), cmpPosition->GetRotation().Y.GetInternalValue() });
+	}
+	for (const CFixedVector2D& point : points)
+		key.insert(key.end(), { point.X.GetInternalValue(), point.Y.GetInternalValue() });
+
+	SRallyGroup& group = current[ent];
+	const auto last = m_RallyGroups.find(ent);
+	if (last != m_RallyGroups.end() && last->second.key == key)
+	{
+		group = last->second;
+		return group.bytes;
+	}
+	group.key = std::move(key);
+	std::vector<u8>& bytes = group.bytes;
+	const u8 count = placed ? static_cast<u8>(std::min<size_t>(points.size(), 0xFF)) : 0;
+	bytes.push_back(count);
+
+	// CreateMarkerEntity's template, and the actor CCmpVisualActor makes of
+	// it with the marker's own civ.
+	CmpPtr<ICmpTemplateManager> cmpTemplateManager(simulation, SYSTEM_ENTITY);
+	const CParamNode* templateNode = cmpTemplateManager ? cmpTemplateManager->GetTemplate(cmpTemplateManager->GetCurrentTemplateName(ent)) : nullptr;
+	const CParamNode* rallyRenderer = templateNode ? &templateNode->GetChild("RallyPointRenderer") : nullptr;
+	std::wstring markerActor;
+	CmpPtr<ICmpPlayerManager> cmpPlayerManager(simulation, SYSTEM_ENTITY);
+	if (count && rallyRenderer && rallyRenderer->IsOk() && cmpPlayerManager && owner != INVALID_PLAYER)
+	{
+		CmpPtr<ICmpIdentity> cmpPlayerIdentity(simulation, cmpPlayerManager->GetPlayerByID(owner));
+		std::wstring markerTemplate = rallyRenderer->GetChild("MarkerTemplate").ToWString();
+		if (cmpPlayerIdentity && !markerTemplate.empty())
+		{
+			PS::ReplaceSubrange(markerTemplate, L"{civ}", cmpPlayerIdentity->GetCiv());
+			if (const CParamNode* marker = cmpTemplateManager->GetTemplate(utf8_from_wstring(markerTemplate)))
+			{
+				markerActor = marker->GetChild("VisualActor").GetChild("Actor").ToWString();
+				PS::ReplaceSubrange(markerActor, L"{civ}", marker->GetChild("Identity").GetChild("Civ").ToWString());
+			}
+		}
+	}
+	PutU32(bytes, InternString(utf8_from_wstring(markerActor)));
+
+	CmpPtr<ICmpFootprint> cmpFootprint(simulation, ent);
+	CmpPtr<ICmpPathfinder> cmpPathfinder(simulation, SYSTEM_ENTITY);
+	const bool pathed = rallyRenderer && rallyRenderer->IsOk() && cmpPathfinder;
+	const pass_class_t passClass = pathed ? cmpPathfinder->GetPassabilityClass(rallyRenderer->GetChild("LinePassabilityClass").ToString()) : 0;
+	const entity_pos_t lineRadius = pathed ? rallyRenderer->GetChild("LineThickness").ToFixed() : entity_pos_t::Zero();
+	for (size_t i = 0; i < count; ++i)
+	{
+		PutF32(bytes, points[i].X.ToFloat());
+		PutF32(bytes, points[i].Y.ToFloat());
+		const std::vector<CVector2D> path = pathed ?
+			RallyPath(simulation.GetSimContext(), cmpPosition, cmpFootprint, points, i, passClass, lineRadius) :
+			std::vector<CVector2D>();
+		const size_t length = std::min<size_t>(path.size(), 0xFFFF);
+		PutU16(bytes, static_cast<u16>(length));
+		for (size_t j = 0; j < length; ++j)
+		{
+			PutF32(bytes, path[j].X);
+			PutF32(bytes, path[j].Y);
+		}
+	}
+	return group.bytes;
+}
