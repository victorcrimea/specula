+// What the tooltips read: GetTemplateData of each template an entity or a
+// trainable list has, for the owner, as GetTemplateData in
+// gui/session/session.js asks for it, and of each researchable technology
+// for the owner's civ, as GetTechnologyData there makes it. A template's is
+// sent again when GuiInterface flags its owner's modifiers as changed.
+void CSpeculaFeed::WriteTemplateData(CSimulation2& simulation, const ScriptRequest& rq, const std::unordered_map<entity_id_t, SDetailGroups>& entities, const SProductionCache& cache)
+{
+	CmpPtr<ICmpTemplateManager> cmpTemplateManager(simulation, SYSTEM_ENTITY);
+	CmpPtr<ICmpPlayerManager> cmpPlayerManager(simulation, SYSTEM_ENTITY);
+	if (!cmpTemplateManager || !cmpPlayerManager)
+		return;
+
+	// The session GUI reads and clears these flags each update; nothing
+	// else does in a nonvisual observer, and they are not serialized.
+	std::set<player_id_t> modified;
+	for (player_id_t player = 0; player < cmpPlayerManager->GetNumPlayers(); ++player)
+	{
+		JS::RootedValue arg(rq.cx);
+		JS::RootedValue result(rq.cx);
+		CallGui(simulation, player, L"IsTemplateModified", arg, &result);
+		if (Truthy(result))
+			modified.insert(player);
+	}
+	if (!modified.empty())
+	{
+		JS::RootedValue arg(rq.cx);
+		JS::RootedValue ignored(rq.cx);
+		CallGui(simulation, INVALID_PLAYER, L"ResetTemplateModified", arg, &ignored);
+	}
+
+	std::set<std::pair<std::string, player_id_t>> templates;
+	for (const std::pair<const entity_id_t, SDetailGroups>& entry : entities)
+	{
+		CmpPtr<ICmpOwnership> cmpOwnership(simulation, entry.first);
+		templates.emplace(cmpTemplateManager->GetCurrentTemplateName(entry.first),
+			cmpOwnership ? cmpOwnership->GetOwner() : INVALID_PLAYER);
+	}
+	for (const auto& entry : cache.trainable)
+		templates.emplace(entry.first.second, entry.first.first);
+	for (const std::pair<std::string, player_id_t>& key : templates)
+	{
+		const auto sent = m_TemplateData.find(key);
+		if (sent != m_TemplateData.end() && modified.find(key.second) == modified.end())
+			continue;
+		JS::RootedValue arg(rq.cx);
+		JS::RootedValue data(rq.cx);
+		Script::CreateObject(rq, &arg, "templateName", key.first, "player", key.second);
+		CallGui(simulation, key.second, L"GetTemplateData", arg, &data);
+		if (!data.isObject())
+			continue;
+		std::string json = Script::StringifyJSON(rq, &data, false);
+		if (sent != m_TemplateData.end() && sent->second == json)
+			continue;
+		const u32 name = InternString(key.first);
+		const size_t start = BeginRecord(m_Buffer, RECORD_TEMPLATE_DATA);
+		PutU32(m_Buffer, name);
+		PutI32(m_Buffer, key.second);
+		m_Buffer.insert(m_Buffer.end(), json.begin(), json.end());
+		EndRecord(m_Buffer, start);
+		m_TemplateData[key] = std::move(json);
+	}
+
+	JS::RootedValue global(rq.cx, rq.globalValue());
+	JS::RootedValue technologyTemplates(rq.cx);
+	JS::RootedValue resources(rq.cx);
+	if (!ScriptInterface::GetGlobalProperty(rq, "TechnologyTemplates", &technologyTemplates) ||
+	    !ScriptInterface::GetGlobalProperty(rq, "Resources", &resources))
+		return;
+	for (const auto& entry : cache.technologies)
+	{
+		const auto civ = cache.civs.find(entry.first.first);
+		if (civ == cache.civs.end() || entry.first.second.empty())
+			continue;
+		if (!m_TechnologyData.emplace(entry.first.second, civ->second).second)
+			continue;
+		JS::RootedValue techTemplate(rq.cx);
+		JS::RootedValue data(rq.cx);
+		ScriptFunction::Call(rq, technologyTemplates, "Get", &techTemplate, entry.first.second);
+		if (!techTemplate.isObject())
+			continue;
+		ScriptFunction::Call(rq, global, "GetTechnologyDataHelper", &data, techTemplate, civ->second, resources);
+		if (!data.isObject())
+			continue;
+		const std::string json = Script::StringifyJSON(rq, &data, false);
+		const u32 name = InternString(entry.first.second);
+		const u32 civName = InternString(civ->second);
+		const size_t start = BeginRecord(m_Buffer, RECORD_TECHNOLOGY_DATA);
+		PutU32(m_Buffer, name);
+		PutU32(m_Buffer, civName);
+		m_Buffer.insert(m_Buffer.end(), json.begin(), json.end());
+		EndRecord(m_Buffer, start);
+	}
+}
