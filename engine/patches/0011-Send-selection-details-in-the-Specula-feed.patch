+void CSpeculaFeed::WriteDetails(CSimulation2& simulation, u32 turn)
+{
+	const double startTime = timer_Time();
+	CmpPtr<ICmpTemplateManager> cmpTemplateManager(simulation, SYSTEM_ENTITY);
+	if (!cmpTemplateManager)
+		return;
+	const CComponentManager& componentManager = simulation.GetSimContext().GetComponentManager();
+	ScriptRequest rq(simulation.GetScriptInterface());
+	// The lists ask for technology requirements, which costs too much to do
+	// every turn.
+	const bool sampleLists = m_DetailsTurns == 0 || turn % PLAYERS_INTERVAL_TURNS == 0;
+
+	std::array<int, std::size(DETAIL_INTERFACES)> iids;
+	for (size_t i = 0; i < iids.size(); ++i)
+	{
+		JS::RootedValue iid(rq.cx);
+		iids[i] = -1;
+		if (ScriptInterface::GetGlobalProperty(rq, std::string("IID_") + DETAIL_INTERFACES[i], &iid) && iid.isInt32())
+			iids[i] = iid.toInt32();
+	}
+
+	std::unordered_map<entity_id_t, SDetailGroups> current;
+	for (size_t i = 0; i < iids.size(); ++i)
+	{
+		if (iids[i] < 0)
+			continue;
+		const std::string_view interface = DETAIL_INTERFACES[i];
+		for (const std::pair<const entity_id_t, IComponent*>& pair : simulation.GetEntitiesWithInterfaceUnordered(iids[i]))
+		{
+			const entity_id_t ent = pair.first;
+			if (ENTITY_IS_LOCAL(ent))
+				continue;
+			JS::RootedValue component(rq.cx, pair.second->GetJSInstance());
+			SDetailGroups& groups = current[ent];
+			if (interface == "Health")
+			{
+				std::vector<u8>& group = groups[DETAIL_HEALTH];
+				PutF32(group, CallFloat(rq, component, "GetHitpoints"));
+				PutF32(group, CallFloat(rq, component, "GetMaxHitpoints"));
+			}
+			else if (interface == "Capturable")
+			{
+				JS::RootedValue points(rq.cx);
+				ScriptFunction::Call(rq, component, "GetCapturePoints", &points);
+				const u32 count = std::min<u32>(ArrayLength(rq, points), 0xFF);
+				std::vector<u8>& group = groups[DETAIL_CAPTURE];
+				group.push_back(static_cast<u8>(count));
+				for (u32 j = 0; j < count; ++j)
+				{
+					double value = 0.0;
+					Script::GetPropertyInt(rq, points, static_cast<int>(j), value);
+					PutF32(group, static_cast<float>(value));
+				}
+				PutF32(group, CallFloat(rq, component, "GetMaxCapturePoints"));
+			}
+			else if (interface == "ResourceSupply")
+			{
+				PutF32(groups[DETAIL_SUPPLY], CallFloat(rq, component, "GetCurrentAmount"));
+				PutF32(groups[DETAIL_SUPPLY], CallFloat(rq, component, "GetMaxAmount"));
+				groups[DETAIL_GATHERERS].push_back(Clamp8(static_cast<u32>(CallFloat(rq, component, "GetNumGatherers"))));
+				groups[DETAIL_GATHERERS].push_back(Clamp8(static_cast<u32>(CallFloat(rq, component, "GetMaxGatherers"))));
+			}
+			else if (interface == "ResourceGatherer")
+			{
+				JS::RootedValue carrying(rq.cx);
+				ScriptFunction::Call(rq, component, "GetCarryingStatus", &carrying);
+				const u32 count = std::min<u32>(ArrayLength(rq, carrying), 0xFF);
+				std::vector<u8>& group = groups[DETAIL_CARRYING];
+				group.push_back(static_cast<u8>(count));
+				for (u32 j = 0; j < count; ++j)
+				{
+					JS::RootedValue item(rq.cx);
+					std::string type;
+					Script::GetPropertyInt(rq, carrying, static_cast<int>(j), &item);
+					Script::GetProperty(rq, item, "type", type);
+					PutU32(group, InternString(type));
+					PutF32(group, PropertyFloat(rq, item, "amount"));
+					PutF32(group, PropertyFloat(rq, item, "max"));
+				}
+			}
+			else if (interface == "Promotion")
+			{
+				PutF32(groups[DETAIL_EXPERIENCE], CallFloat(rq, component, "GetCurrentXp"));
+				PutF32(groups[DETAIL_EXPERIENCE], CallFloat(rq, component, "GetRequiredXp"));
+			}
+			else if (interface == "ProductionQueue")
+			{
+				JS::RootedValue queue(rq.cx);
+				ScriptFunction::Call(rq, component, "GetQueue", &queue);
+				const u32 count = std::min<u32>(ArrayLength(rq, queue), 0xFF);
+				std::vector<u8>& group = groups[DETAIL_QUEUE];
+				group.push_back(CallBool(rq, component, "IsAutoQueueing") ? 1 : 0);
+				group.push_back(static_cast<u8>(count));
+				for (u32 j = 0; j < count; ++j)
+				{
+					JS::RootedValue item(rq.cx);
+					Script::GetPropertyInt(rq, queue, static_cast<int>(j), &item);
+					std::string name;
+					const bool technology = !Script::HasProperty(rq, item, "unitTemplate");
+					Script::GetProperty(rq, item, technology ? "technologyTemplate" : "unitTemplate", name);
+					JS::RootedValue paused(rq.cx);
+					Script::GetProperty(rq, item, "paused", &paused);
+					PutU32(group, static_cast<u32>(PropertyFloat(rq, item, "id")));
+					group.push_back(technology ? QUEUE_TECHNOLOGY : QUEUE_UNIT);
+					PutU32(group, InternString(name));
+					PutU16(group, technology ? 1 : Clamp16(static_cast<u32>(PropertyFloat(rq, item, "count"))));
+					PutF32(group, PropertyFloat(rq, item, "progress"));
+					PutF32(group, PropertyFloat(rq, item, "timeRemaining"));
+					group.push_back(Truthy(paused) ? 1 : 0);
+					PutU16(group, Clamp16(static_cast<u32>(PropertyFloat(rq, item, "neededSlots"))));
+				}
+			}
+			else if (interface == "GarrisonHolder")
+			{
+				std::vector<u32> held;
+				ScriptFunction::Call(rq, component, "GetEntities", held);
+				std::vector<u8>& group = groups[DETAIL_GARRISON];
+				PutU16(group, Clamp16(static_cast<u32>(CallFloat(rq, component, "GetCapacity"))));
+				PutU16(group, Clamp16(static_cast<u32>(CallFloat(rq, component, "OccupiedSlots"))));
+				PutU16(group, Clamp16(static_cast<u32>(held.size())));
+				for (size_t j = 0; j < std::min<size_t>(held.size(), 0xFFFF); ++j)
+				{
+					PutU32(group, held[j]);
+					PutU32(group, InternTemplate(simulation, held[j], cmpTemplateManager->GetCurrentTemplateName(held[j])));
+				}
+			}
+			else if (interface == "Foundation" || interface == "Repairable")
+			{
+				JS::RootedValue buildTime(rq.cx);
+				ScriptFunction::Call(rq, component, "GetBuildTime", &buildTime);
+				std::vector<u8>& group = groups[interface == "Foundation" ? DETAIL_FOUNDATION : DETAIL_REPAIR];
+				group.push_back(Clamp8(static_cast<u32>(CallFloat(rq, component, "GetNumBuilders"))));
+				PutF32(group, PropertyFloat(rq, buildTime, "timeRemaining"));
+			}
+			else if (interface == "UnitAI")
+			{
+				JS::RootedValue state(rq.cx);
+				JS::RootedValue stance(rq.cx);
+				ScriptFunction::Call(rq, component, "GetCurrentState", &state);
+				ScriptFunction::Call(rq, component, "GetStanceName", &stance);
+				std::vector<u8>& group = groups[DETAIL_UNIT_AI];
+				PutU32(group, InternString(StringOf(rq, state)));
+				group.push_back(CallBool(rq, component, "IsIdle") ? 1 : 0);
+				PutU32(group, InternString(StringOf(rq, stance)));
+				PutU32(group, static_cast<u32>(CallFloat(rq, component, "GetFormationController")));
+			}
+			else if (interface == "Trainer" || interface == "Researcher")
+			{
+				const size_t slot = interface == "Trainer" ? DETAIL_TRAINABLE : DETAIL_RESEARCHABLE;
+				if (!sampleLists)
+				{
+					const auto last = m_LastDetails.find(ent);
+					if (last != m_LastDetails.end())
+						groups[slot] = last->second[slot];
+					continue;
+				}
+				JS::RootedValue list(rq.cx);
+				ScriptFunction::Call(rq, component, interface == "Trainer" ? "GetEntitiesList" : "GetTechnologiesList", &list);
+				const u32 count = ArrayLength(rq, list);
+				std::vector<u32> strings;
+				for (u32 j = 0; j < count; ++j)
+				{
+					JS::RootedValue item(rq.cx);
+					Script::GetPropertyInt(rq, list, static_cast<int>(j), &item);
+					std::string name = StringOf(rq, item);
+					if (item.isObject())
+					{
+						std::string top;
+						std::string bottom;
+						Script::GetProperty(rq, item, "top", top);
+						Script::GetProperty(rq, item, "bottom", bottom);
+						name = top + " " + bottom;
+					}
+					strings.push_back(InternString(name));
+				}
+				PutU32(groups[slot], InternStringList(strings));
+			}
+			else if (interface == "Pack" || interface == "Upgrade")
+			{
+				std::vector<u8>& group = groups[DETAIL_PROGRESS];
+				if (!group.empty())
+					continue;
+				float packProgress = -1.0f;
+				float upgradeProgress = -1.0f;
+				std::string upgradeTarget;
+				if (iids[INTERFACE_PACK] >= 0)
+					if (IComponent* pack = componentManager.QueryInterface(ent, iids[INTERFACE_PACK]))
+					{
+						JS::RootedValue packComponent(rq.cx, pack->GetJSInstance());
+						if (CallBool(rq, packComponent, "IsPacking"))
+							packProgress = CallFloat(rq, packComponent, "GetProgress");
+					}
+				if (iids[INTERFACE_UPGRADE] >= 0)
+					if (IComponent* upgrade = componentManager.QueryInterface(ent, iids[INTERFACE_UPGRADE]))
+					{
+						JS::RootedValue upgradeComponent(rq.cx, upgrade->GetJSInstance());
+						if (CallBool(rq, upgradeComponent, "IsUpgrading"))
+						{
+							upgradeProgress = CallFloat(rq, upgradeComponent, "GetProgress");
+							JS::RootedValue target(rq.cx);
+							ScriptFunction::Call(rq, upgradeComponent, "GetUpgradingTo", &target);
+							upgradeTarget = StringOf(rq, target);
+						}
+					}
+				const u32 target = InternString(upgradeTarget);
+				PutF32(group, packProgress);
+				PutF32(group, upgradeProgress);
+				PutU32(group, target);
+			}
+			else if (interface == "Trader")
+			{
+				JS::RootedValue goods(rq.cx);
+				ScriptFunction::Call(rq, component, "GetGoods", &goods);
+				JS::RootedValue type(rq.cx);
+				JS::RootedValue amount(rq.cx);
+				if (goods.isObject())
+				{
+					Script::GetProperty(rq, goods, "type", &type);
+					Script::GetProperty(rq, goods, "amount", &amount);
+				}
+				const u32 typeString = InternString(StringOf(rq, type));
+				std::vector<u8>& group = groups[DETAIL_TRADER];
+				PutU32(group, typeString);
+				PutF32(group, PropertyFloat(rq, amount, "traderGain") + PropertyFloat(rq, amount, "market1Gain") + PropertyFloat(rq, amount, "market2Gain"));
+			}
+			else if (interface == "Garrisonable" || interface == "Turretable")
+			{
+				std::vector<u8>& group = groups[DETAIL_HOLDER];
+				const u32 holder = static_cast<u32>(CallFloat(rq, component, "HolderID"));
+				if (!group.empty())
+				{
+					if (!holder)
+						continue;
+					group.clear();
+				}
+				PutU32(group, holder);
+			}
+		}
+	}
+
+	std::vector<u8> payload;
+	u32 changed = 0;
+	for (const std::pair<const entity_id_t, SDetailGroups>& entry : current)
+	{
+		const auto last = m_LastDetails.find(entry.first);
+		u32 mask = 0;
+		for (size_t slot = 0; slot < entry.second.size(); ++slot)
+			if (!entry.second[slot].empty() &&
+			    (last == m_LastDetails.end() || last->second[slot] != entry.second[slot]))
+				mask |= 1u << slot;
+		if (!mask)
+			continue;
+		PutU32(payload, entry.first);
+		PutU32(payload, mask);
+		for (size_t slot = 0; slot < entry.second.size(); ++slot)
+			if (mask & (1u << slot))
+				payload.insert(payload.end(), entry.second[slot].begin(), entry.second[slot].end());
+		++changed;
+	}
+	std::vector<u32> gone;
+	for (const std::pair<const entity_id_t, SDetailGroups>& entry : m_LastDetails)
+		if (current.find(entry.first) == current.end())
+			gone.push_back(entry.first);
+
+	if (changed || !gone.empty())
+	{
+		const size_t start = BeginRecord(m_Buffer, RECORD_DETAILS);
+		PutU32(m_Buffer, changed);
+		m_Buffer.insert(m_Buffer.end(), payload.begin(), payload.end());
+		PutU32(m_Buffer, static_cast<u32>(gone.size()));
+		for (const u32 id : gone)
+			PutU32(m_Buffer, id);
+		EndRecord(m_Buffer, start);
+	}
+	m_LastDetails = std::move(current);
+
+	m_DetailsSeconds += timer_Time() - startTime;
+	if (++m_DetailsTurns % DETAILS_LOG_INTERVAL_TURNS == 0)
+	{
+		debug_printf("Specula feed: details took %.2f ms per turn over the last %u turns\n",
+			m_DetailsSeconds * 1000.0 / DETAILS_LOG_INTERVAL_TURNS, DETAILS_LOG_INTERVAL_TURNS);
+		m_DetailsSeconds = 0.0;
+	}
