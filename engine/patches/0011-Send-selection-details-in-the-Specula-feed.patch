+u32 CSpeculaFeed::InternStringList(const std::vector<u32>& strings)
+{
+	const auto [it, inserted] = m_StringListIndices.try_emplace(strings, static_cast<u32>(m_StringListIndices.size()));
+	if (inserted)
+	{
+		const size_t start = BeginRecord(m_Buffer, RECORD_STRING_LIST);
+		PutU32(m_Buffer, it->second);
+		PutU32(m_Buffer, static_cast<u32>(strings.size()));
+		for (const u32 string : strings)
+			PutU32(m_Buffer, string);
+		EndRecord(m_Buffer, start);
+	}
+	return it->second;
+}
+
+u32 CSpeculaFeed::InternTemplate(CSimulation2& simulation, entity_id_t ent, const std::string& templateName)
+{
+	const auto [it, inserted] = m_TemplateIndices.try_emplace(templateName,
+		static_cast<u32>(m_TemplateIndices.size()));
+	if (!inserted)
+		return it->second;
+
+	const size_t start = BeginRecord(m_Buffer, RECORD_TEMPLATE);
+	PutU32(m_Buffer, it->second);
+	PutU16(m_Buffer, static_cast<u16>(templateName.size()));
+	m_Buffer.insert(m_Buffer.end(), templateName.begin(), templateName.end());
+	// The icon comes from the template, so every entity of it shares the
+	// first one's.
+	CmpPtr<ICmpMinimap> cmpMinimap(simulation, ent);
+	const bool hasIcon = cmpMinimap && cmpMinimap->HasIcon();
+	const float iconSize = hasIcon ? cmpMinimap->GetIconSize() : 0.0f;
+	u32 iconSizeBits;
+	std::memcpy(&iconSizeBits, &iconSize, sizeof(iconSizeBits));
+	PutU32(m_Buffer, iconSizeBits);
+	// Same test as CCmpMinimap::Init: a template without its own colour is
+	// drawn in the owner's.
+	bool playerColor = false;
+	CmpPtr<ICmpTemplateManager> cmpTemplateManager(simulation, SYSTEM_ENTITY);
+	if (const CParamNode* templateNode = cmpTemplateManager ? cmpTemplateManager->GetTemplate(templateName) : nullptr)
+	{
+		const CParamNode& minimapNode = templateNode->GetChild("Minimap");
+		playerColor = minimapNode.IsOk() && !minimapNode.GetChild("Color").IsOk();
+	}
+	m_Buffer.push_back(playerColor ? TEMPLATE_PLAYER_COLOR : 0);
+	if (hasIcon)
+	{
+		std::string icon = cmpMinimap->GetIconPath();
+		if (icon.compare(0, ICON_DIRECTORY.size(), ICON_DIRECTORY) == 0)
+			icon.erase(0, ICON_DIRECTORY.size());
+		m_Buffer.insert(m_Buffer.end(), icon.begin(), icon.end());
+	}
+	EndRecord(m_Buffer, start);
+
+	WriteTemplateDetails(simulation, it->second, templateName);
+	return it->second;
+}
+
+// Read from the template as CCmpSelectable, CCmpFootprint, StatusBars.js and
+// Identity.js read it; none of these are changed by technologies.
+void CSpeculaFeed::WriteTemplateDetails(CSimulation2& simulation, u32 index, const std::string& templateName)
+{
+	CmpPtr<ICmpTemplateManager> cmpTemplateManager(simulation, SYSTEM_ENTITY);
+	const CParamNode* templateNode = cmpTemplateManager ? cmpTemplateManager->GetTemplate(templateName) : nullptr;
+	if (!templateNode)
+		return;
+
+	// Interned first, as string records must precede this one.
+	const CParamNode& selectable = templateNode->GetChild("Selectable");
+	const CParamNode& overlay = selectable.GetChild("Overlay");
+	const CParamNode& texture = overlay.GetChild("Texture");
+	const CParamNode& outline = overlay.GetChild("Outline");
+	const u32 overlayTexture = InternString(texture.IsOk() ? texture.GetChild("MainTexture").ToString() : outline.GetChild("LineTexture").ToString());
+	const u32 overlayMask = InternString(texture.IsOk() ? texture.GetChild("MainTextureMask").ToString() : outline.GetChild("LineTextureMask").ToString());
+	const CParamNode& identity = templateNode->GetChild("Identity");
+	const u32 genericName = InternString(identity.GetChild("GenericName").ToString());
+	const u32 specificName = InternString(identity.GetChild("SpecificName").ToString());
+	const u32 icon = InternString(identity.GetChild("Icon").ToString());
+	const u32 selectionGroupName = InternString(identity.GetChild("SelectionGroupName").ToString());
+	const u32 rank = InternString(identity.GetChild("Rank").ToString());
+	const u32 classes = InternString(identity.GetChild("Classes").ToString());
+	const u32 visibleClasses = InternString(identity.GetChild("VisibleClasses").ToString());
+	const u32 selectSound = InternString(templateNode->GetChild("Sound").GetChild("SoundGroups").GetChild("select").ToString());
+
+	u16 flags = 0;
+	if (selectable.IsOk())
+		flags |= TEMPLATE_SELECTABLE;
+	if (selectable.GetChild("EditorOnly").IsOk())
+		flags |= TEMPLATE_EDITOR_ONLY;
+	if (outline.IsOk())
+		flags |= TEMPLATE_OUTLINE;
+	if (overlay.GetChild("AlwaysVisible").IsOk())
+		flags |= TEMPLATE_ALWAYS_VISIBLE;
+	if (templateNode->GetChild("VisualActor").GetChild("SelectionShape").GetChild("Footprint").IsOk())
+		flags |= TEMPLATE_SELECT_FOOTPRINT;
+
+	const CParamNode& shape = overlay.GetChild("Shape");
+	float overlayWidth = 0.0f;
+	float overlayDepth = 0.0f;
+	if (shape.GetChild("Square").IsOk())
+	{
+		flags |= TEMPLATE_OVERLAY_SQUARE;
+		overlayWidth = NodeFloat(shape.GetChild("Square").GetChild("@width"));
+		overlayDepth = NodeFloat(shape.GetChild("Square").GetChild("@depth"));
+	}
+	else if (shape.GetChild("Circle").IsOk())
+	{
+		flags |= TEMPLATE_OVERLAY_CIRCLE;
+		overlayWidth = overlayDepth = NodeFloat(shape.GetChild("Circle").GetChild("@radius"));
+	}
+
+	const CParamNode& footprint = templateNode->GetChild("Footprint");
+	float footprintWidth = 0.0f;
+	float footprintDepth = 0.0f;
+	if (footprint.IsOk())
+	{
+		flags |= TEMPLATE_FOOTPRINT;
+		if (footprint.GetChild("Square").IsOk())
+		{
+			flags |= TEMPLATE_FOOTPRINT_SQUARE;
+			footprintWidth = NodeFloat(footprint.GetChild("Square").GetChild("@width"));
+			footprintDepth = NodeFloat(footprint.GetChild("Square").GetChild("@depth"));
+		}
+		else
+			footprintWidth = footprintDepth = NodeFloat(footprint.GetChild("Circle").GetChild("@radius"));
+	}
+
+	const CParamNode& statusBars = templateNode->GetChild("StatusBars");
+	if (statusBars.IsOk())
+		flags |= TEMPLATE_STATUS_BARS;
+	const CParamNode& supplyMax = templateNode->GetChild("ResourceSupply").GetChild("Max");
+	if (supplyMax.IsOk() && supplyMax.ToString() == "Infinity")
+		flags |= TEMPLATE_INFINITE_SUPPLY;
+
+	u32 components = 0;
+	for (size_t i = 0; i < std::size(DETAIL_INTERFACES); ++i)
+		if (templateNode->GetChild(DETAIL_INTERFACES[i]).IsOk())
+			components |= 1u << i;
+
+	const size_t start = BeginRecord(m_Buffer, RECORD_TEMPLATE_DETAILS);
+	PutU32(m_Buffer, index);
+	PutU16(m_Buffer, flags);
+	PutU32(m_Buffer, overlayTexture);
+	PutU32(m_Buffer, overlayMask);
+	PutF32(m_Buffer, NodeFloat(outline.GetChild("LineThickness")));
+	PutF32(m_Buffer, overlayWidth);
+	PutF32(m_Buffer, overlayDepth);
+	PutF32(m_Buffer, footprintWidth);
+	PutF32(m_Buffer, footprintDepth);
+	PutF32(m_Buffer, NodeFloat(footprint.GetChild("Height")));
+	PutF32(m_Buffer, NodeFloat(statusBars.GetChild("BarWidth")));
+	PutF32(m_Buffer, NodeFloat(statusBars.GetChild("BarHeight")));
+	PutF32(m_Buffer, NodeFloat(statusBars.GetChild("HeightOffset")));
+	for (const u32 string : { genericName, specificName, icon, selectionGroupName, rank, classes, visibleClasses, selectSound })
+		PutU32(m_Buffer, string);
+	PutU32(m_Buffer, components);
+	EndRecord(m_Buffer, start);
+}
+
+// The session GUI reads and clears this list every update; nothing else
+// does in a nonvisual observer, and it is not serialized.
+void CSpeculaFeed::WriteRenames(CSimulation2& simulation)
+{
+	CmpPtr<ICmpGuiInterface> cmpGuiInterface(simulation, SYSTEM_ENTITY);
+	if (!cmpGuiInterface)
+		return;
+	ScriptRequest rq(simulation.GetScriptInterface());
+	JS::RootedValue arg(rq.cx);
+	JS::RootedValue renames(rq.cx);
+	cmpGuiInterface->ScriptCall(INVALID_PLAYER, L"GetRenamedEntities", arg, &renames);
+	JS::RootedValue ignored(rq.cx);
+	cmpGuiInterface->ScriptCall(INVALID_PLAYER, L"ClearRenamedEntities", arg, &ignored);
+
+	const u32 count = ArrayLength(rq, renames);
+	if (!count)
+		return;
+	const size_t start = BeginRecord(m_Buffer, RECORD_RENAMES);
+	PutU32(m_Buffer, count);
+	for (u32 i = 0; i < count; ++i)
+	{
+		JS::RootedValue rename(rq.cx);
+		u32 oldId = 0;
+		u32 newId = 0;
+		if (Script::GetPropertyInt(rq, renames, static_cast<int>(i), &rename))
+		{
+			Script::GetProperty(rq, rename, "entity", oldId);
+			Script::GetProperty(rq, rename, "newentity", newId);
+		}
+		PutU32(m_Buffer, oldId);
+		PutU32(m_Buffer, newId);
+	}
+	EndRecord(m_Buffer, start);
+}
