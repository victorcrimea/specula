+// The getters below are the ones GuiInterface.GetEntityState calls: the
+// session GUI calls them at any time, outside the synchronised turn, so they
+// cannot change the state hash.
+// Several getters return undefined for "none" (HolderID out of a holder,
+// IsPacking before the first pack), which the typed conversions would log as
+// errors; undefined reads as 0 or false.
+float CallFloat(const ScriptRequest& rq, JS::HandleValue component, const char* name)
+{
+	JS::RootedValue value(rq.cx);
+	if (!ScriptFunction::Call(rq, component, name, &value) || !value.isNumber())
+		return 0.0f;
+	return static_cast<float>(value.toNumber());
+}
+
+// Only the getters' own results: true, or a count above 0.
+bool Truthy(JS::HandleValue value)
+{
+	return value.isBoolean() ? value.toBoolean() : value.isNumber() && value.toNumber() != 0.0;
+}
+
+bool CallBool(const ScriptRequest& rq, JS::HandleValue component, const char* name)
+{
+	JS::RootedValue value(rq.cx);
+	return ScriptFunction::Call(rq, component, name, &value) && Truthy(value);
+}
+
+float PropertyFloat(const ScriptRequest& rq, JS::HandleValue object, const char* name)
+{
+	JS::RootedValue value(rq.cx);
+	if (!object.isObject() || !Script::GetProperty(rq, object, name, &value) || !value.isNumber())
+		return 0.0f;
+	return static_cast<float>(value.toNumber());
+}
+
+u32 ArrayLength(const ScriptRequest& rq, JS::HandleValue array)
+{
+	u32 length = 0;
+	if (!array.isObject() || !Script::GetProperty(rq, array, "length", length))
+		return 0;
+	return length;
+}
+
+// A getter's string result, or empty for anything else (undefined when
+// there is nothing to name).
+std::string StringOf(const ScriptRequest& rq, JS::HandleValue value)
+{
+	std::string text;
+	if (value.isString())
+		Script::FromJSVal(rq, value, text);
+	return text;
+}
+
+u8 Clamp8(u32 value)
+{
+	return static_cast<u8>(std::min<u32>(value, 0xFF));
+}
+
+u16 Clamp16(u32 value)
+{
+	return static_cast<u16>(std::min<u32>(value, 0xFFFF));
+}
+
+float NodeFloat(const CParamNode& node)
+{
+	return node.IsOk() ? node.ToFloat() : 0.0f;
+}
