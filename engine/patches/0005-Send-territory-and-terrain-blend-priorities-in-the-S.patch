From 5a4a82bf479b74cdadbfbe96cb6b71dfd370a3ee Mon Sep 17 00:00:00 2001
From: Viktor Semenov <suit.uanic@gmail.com>
Date: Tue, 6 Oct 2026 23:14:52 +0000
Subject: [PATCH 05/45] Send territory and terrain blend priorities in the
 Specula feed

Feed format v8. A territory record carries ICmpTerritoryManager's grid
(owner, connected and blinking bits per tile, without the internal
processed bit) before the turn record, whenever the territory or its
blinking changed, as the AI follows them through NeedUpdateAI. The
territory manager does not serialize its grid and visual clients
compute it every frame, so reading it cannot change the simulation or
its hash.

The terrain record also gains each tile's blend priority, which
CMapReader now hands on beside the texture index.

A nonvisual observer now quits once its connection to the host is
gone: nothing reads the GUI's netstatus message in that mode, so it
would otherwise wait for turns forever instead of exiting to be
restarted.
---
 source/graphics/MapReader.cpp  | 10 ++++++++--
 source/main.cpp                |  6 ++++++
 source/network/SpeculaFeed.cpp | 29 +++++++++++++++++++++++++++--
 source/network/SpeculaFeed.h   | 16 ++++++++++++----
 4 files changed, 53 insertions(+), 8 deletions(-)

diff --git a/source/graphics/MapReader.cpp b/source/graphics/MapReader.cpp
index 375786949e..6f2916c569 100644
--- a/source/graphics/MapReader.cpp
+++ b/source/graphics/MapReader.cpp
@@ -372,13 +372,19 @@ int CMapReader::ApplyTerrainData()
 		// Specula: m_Tiles is in patch order; the feed wants row-major tiles.
 		const ssize_t tilesPerSide = m_PatchesPerSide * PATCH_SIZE;
 		std::vector<u16> tileTextures(SQR(tilesPerSide));
+		std::vector<u32> tilePriorities(SQR(tilesPerSide));
 		const STileDesc* tile = m_Tiles.data();
 		for (ssize_t j = 0; j < m_PatchesPerSide; ++j)
 			for (ssize_t i = 0; i < m_PatchesPerSide; ++i)
 				for (ssize_t m = 0; m < PATCH_SIZE; ++m)
 					for (ssize_t k = 0; k < PATCH_SIZE; ++k)
-						tileTextures[(j * PATCH_SIZE + m) * tilesPerSide + i * PATCH_SIZE + k] = (tile++)->m_Tex1Index;
-		CSpeculaFeed::SetTerrainTextures(m_TerrainTextureNames, std::move(tileTextures));
+					{
+						const ssize_t at = (j * PATCH_SIZE + m) * tilesPerSide + i * PATCH_SIZE + k;
+						tileTextures[at] = tile->m_Tex1Index;
+						tilePriorities[at] = tile->m_Priority;
+						++tile;
+					}
+		CSpeculaFeed::SetTerrainTextures(m_TerrainTextureNames, std::move(tileTextures), std::move(tilePriorities));
 
 		if (CTerrainTextureManager::IsInitialised())
 		{
diff --git a/source/main.cpp b/source/main.cpp
index 0ad09c1815..ec60671577 100644
--- a/source/main.cpp
+++ b/source/main.cpp
@@ -509,6 +509,12 @@ static void NonVisualFrame()
 
 	if (g_Game->IsGameFinished())
 		QuitEngine(EXIT_SUCCESS);
+
+	// Specula: nothing reads the GUI's netstatus message in nonvisual mode,
+	// so a vanished host would otherwise leave the observer waiting for
+	// turns forever instead of exiting to be restarted.
+	if (g_NetClient && g_NetClient->GetCurrState() == NCS_UNCONNECTED)
+		QuitEngine(EXIT_FAILURE);
 }
 
 static void MainControllerInit()
