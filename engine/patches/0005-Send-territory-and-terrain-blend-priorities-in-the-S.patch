 #include "simulation2/system/CmpPtr.h"
 #include "simulation2/system/Entity.h"
 #include "simulation2/system/ParamNode.h"
@@ -49,7 +51,7 @@
 
 namespace
 {
-constexpr u32 FEED_VERSION = 6;
+constexpr u32 FEED_VERSION = 8;
 constexpr u8 RECORD_TEMPLATE = 1;
 constexpr u8 RECORD_TURN = 2;
 constexpr u8 RECORD_MAP = 3;
@@ -57,6 +59,7 @@ constexpr u8 RECORD_TERRAIN = 4;
 constexpr u8 RECORD_PLAYERS = 5;
 constexpr u8 RECORD_STRING = 6;
 constexpr u8 RECORD_VARIANT_SET = 7;
+constexpr u8 RECORD_TERRITORY = 8;
 constexpr u8 COLOR_MINIMAP = 1;
 constexpr u8 HAS_VISUAL = 2;
 constexpr u8 ANIMATION_ONCE = 4;
@@ -81,6 +84,7 @@ const CStr ANIMATION_KEY = "animation";
 
 std::vector<std::string> g_TerrainTextureNames;
 std::vector<u16> g_TerrainTextureTiles;
+std::vector<u32> g_TerrainTexturePriorities;
 
 struct SEntity
 {
@@ -201,6 +205,7 @@ void CSpeculaFeed::OnTurn(CSimulation2& simulation, u32 turn)
 
 	if (m_LastPlayers.empty() || turn % PLAYERS_INTERVAL_TURNS == 0)
 		WritePlayers(simulation);
+	WriteTerritory(simulation);
 
 	// Template records must precede the turn record that first uses them,
 	// so the entities are collected before the turn record is written.
@@ -314,10 +319,11 @@ void CSpeculaFeed::OnTurn(CSimulation2& simulation, u32 turn)
 	Send();
 }
 
-void CSpeculaFeed::SetTerrainTextures(const std::vector<std::string>& names, std::vector<u16> tiles)
+void CSpeculaFeed::SetTerrainTextures(const std::vector<std::string>& names, std::vector<u16> tiles, std::vector<u32> priorities)
 {
 	g_TerrainTextureNames = names;
 	g_TerrainTextureTiles = std::move(tiles);
+	g_TerrainTexturePriorities = std::move(priorities);
 }
 
 // An empty text is no string: an actor or animation that was never set.
@@ -436,6 +442,23 @@ void CSpeculaFeed::WritePlayers(CSimulation2& simulation)
 	m_LastPlayers = std::move(payload);
 }
 
+// The territory manager's own dirty ids, as the AI follows them, so the grid
+// is sent only when ownership or decay changed.
+void CSpeculaFeed::WriteTerritory(CSimulation2& simulation)
+{
+	CmpPtr<ICmpTerritoryManager> cmpTerritoryManager(simulation, SYSTEM_ENTITY);
+	if (!cmpTerritoryManager || !cmpTerritoryManager->NeedUpdateAI(&m_TerritoryDirtyID, &m_TerritoryBlinkingDirtyID))
+		return;
+	const Grid<u8>& grid = cmpTerritoryManager->GetTerritoryGrid();
+	const size_t start = BeginRecord(m_Buffer, RECORD_TERRITORY);
+	PutU32(m_Buffer, grid.width());
+	PutU32(m_Buffer, grid.height());
+	for (u16 j = 0; j < grid.height(); ++j)
+		for (u16 i = 0; i < grid.width(); ++i)
+			m_Buffer.push_back(static_cast<u8>(grid.get(i, j) & ~ICmpTerritoryManager::TERRITORY_PROCESSED_MASK));
+	EndRecord(m_Buffer, start);
+}
+
 // Terrain and water level are written once: they only change through
 // trigger scripts, which the view does not follow yet.
 void CSpeculaFeed::WriteTerrain(CSimulation2& simulation)
@@ -475,6 +498,8 @@ void CSpeculaFeed::WriteTerrain(CSimulation2& simulation)
 		}
 	for (size_t i = 0; i < tilesPerSide * tilesPerSide; ++i)
 		PutU16(m_Buffer, haveTextures ? g_TerrainTextureTiles[i] : NO_TEXTURE);
+	for (size_t i = 0; i < tilesPerSide * tilesPerSide; ++i)
+		PutU32(m_Buffer, haveTextures ? g_TerrainTexturePriorities[i] : 0);
 	EndRecord(m_Buffer, start);
 }
 
diff --git a/source/network/SpeculaFeed.h b/source/network/SpeculaFeed.h
