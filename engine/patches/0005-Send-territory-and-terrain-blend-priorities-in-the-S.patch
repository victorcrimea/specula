@@ -35,7 +35,7 @@ class CSimulation2;
  * socket. It only reads the simulation, after each turn, so it cannot
  * change the state hash.
  *
- * Feed format v6, little-endian: "SPCF", u32 version, then records of
+ * Feed format v8, little-endian: "SPCF", u32 version, then records of
  * u8 kind, u32 payload length, payload.
  *  - kind 1 template: u32 index, u16 name length, UTF-8 name, f32 minimap
  *    icon size, u8 flags, then the icon file name relative to
@@ -63,12 +63,17 @@ class CSimulation2;
  *  - kind 4 terrain, right after the map record: u32 tiles per side n,
  *    i32 water level (raw 16.16), f32 shallow water depth in metres,
  *    u8 circular, (n+1)^2 x u16 heights, u32 texture count, count x
- *    {u16 length, UTF-8 name}, n^2 x u16 texture index (0xFFFF: none).
- *    Heights and tiles are row-major, x fastest.
+ *    {u16 length, UTF-8 name}, n^2 x u16 texture index (0xFFFF: none),
+ *    n^2 x u32 blend priority. Heights and tiles are row-major, x fastest.
  *  - kind 5 players, before the turn record, whenever they change: u32
  *    count n, n x {u16 name length, UTF-8 name, u8 r, u8 g, u8 b, i32 team
  *    (-1: none), u8 state (0 active, 1 defeated, 2 won), n x u8 stance
  *    towards player j (0 enemy, 1 ally, 2 neutral)}. Index 0 is gaia.
+ *  - kind 8 territory, before the turn record, whenever it changes: u32
+ *    width, u32 height, width*height x u8 territory tile, row-major, x
+ *    fastest, as ICmpTerritoryManager's grid without the processed bit:
+ *    owner in 0x1F, connected 0x20, blinking 0x40. A tile is
+ *    NAVCELLS_PER_TERRITORY_TILE navcells wide.
  */
 class CSpeculaFeed
 {
@@ -83,11 +88,12 @@ public:
 	 * Called by CMapReader while loading, which happens before the feed
 	 * exists; the textures are kept until the terrain record is written.
 	 */
-	static void SetTerrainTextures(const std::vector<std::string>& names, std::vector<u16> tiles);
+	static void SetTerrainTextures(const std::vector<std::string>& names, std::vector<u16> tiles, std::vector<u32> priorities);
 
 private:
 	void WriteTerrain(CSimulation2& simulation);
 	void WritePlayers(CSimulation2& simulation);
+	void WriteTerritory(CSimulation2& simulation);
 	u32 InternString(const std::string& text);
 	u32 InternVariants(const std::map<CStr, CStr>& selections);
 	bool Send();
@@ -100,6 +106,8 @@ private:
 	std::unordered_map<std::string, u32> m_StringIndices;
 	std::map<std::vector<std::pair<u32, u32>>, u32> m_VariantSetIndices;
 	std::vector<u8> m_LastPlayers;
+	size_t m_TerritoryDirtyID = 0;
+	size_t m_TerritoryBlinkingDirtyID = 0;
 };
 
