+void CSpeculaFeed::PutProductionItem(u32 name, u8 flags, u16 canBeAdded, const std::vector<std::pair<std::string, float>>& costs, std::vector<u8>& out)
+{
+	PutU32(out, name);
+	out.push_back(flags);
+	PutU16(out, canBeAdded);
+	const size_t count = std::min<size_t>(costs.size(), 0xFF);
+	out.push_back(static_cast<u8>(count));
+	for (size_t i = 0; i < count; ++i)
+	{
+		PutU32(out, InternString(costs[i].first));
+		PutF32(out, costs[i].second);
+	}
+}
