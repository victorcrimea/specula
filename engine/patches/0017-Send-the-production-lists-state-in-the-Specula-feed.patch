+// As g_SelectionPanels.Training's setupButton reads it for the owner:
+// GetTemplateData has the costs after the owner's modifiers.
+void CSpeculaFeed::PutTrainable(CSimulation2& simulation, const ScriptRequest& rq, player_id_t owner, const std::string& templateName, SProductionCache& cache, std::vector<u8>& out)
+{
+	const auto [it, inserted] = cache.trainable.try_emplace(std::make_pair(owner, templateName));
+	if (inserted)
+	{
+		JS::RootedValue arg(rq.cx);
+		JS::RootedValue data(rq.cx);
+		Script::CreateObject(rq, &arg, "templateName", templateName, "player", owner);
+		CallGui(simulation, owner, L"GetTemplateData", arg, &data);
+		// setupButton hides an item without template data.
+		if (!data.isObject())
+		{
+			PutProductionItem(InternString(templateName), PRODUCTION_HIDDEN, PRODUCTION_NO_LIMIT, {}, it->second);
+			out.insert(out.end(), it->second.begin(), it->second.end());
+			return;
+		}
+		JS::RootedValue requirements(rq.cx);
+		Script::GetProperty(rq, data, "requirements", &requirements);
+		JS::RootedValue requirementsArg(rq.cx);
+		JS::RootedValue met(rq.cx);
+		Script::CreateObject(rq, &requirementsArg, "requirements", requirements, "player", owner);
+		CallGui(simulation, owner, L"AreRequirementsMet", requirementsArg, &met);
+		JS::RootedValue cost(rq.cx);
+		Script::GetProperty(rq, data, "cost", &cost);
+		PutProductionItem(InternString(templateName), Truthy(met) ? PRODUCTION_REQUIREMENTS_MET : 0,
+			LimitOf(CanBeAddedCount(simulation, rq, owner, templateName, data)), ResourceCosts(rq, cost), it->second);
+	}
+	out.insert(out.end(), it->second.begin(), it->second.end());
+}
+
+// As g_SelectionPanels.Research's setupButton reads it for the owner: the
+// technology's own costs times the producer's multiplier.
+void CSpeculaFeed::PutResearchable(CSimulation2& simulation, const ScriptRequest& rq, player_id_t owner, const std::string& technology, const std::map<std::string, float>& multipliers, u8 flags, SProductionCache& cache, std::vector<u8>& out)
+{
+	const auto [it, inserted] = cache.technologies.try_emplace(std::make_pair(owner, technology));
+	STechnologyState& state = it->second;
+	if (inserted)
+	{
+		const auto [civ, civInserted] = cache.civs.try_emplace(owner);
+		if (civInserted)
+		{
+			CmpPtr<ICmpPlayerManager> cmpPlayerManager(simulation, SYSTEM_ENTITY);
+			CmpPtr<ICmpIdentity> cmpIdentity(simulation, cmpPlayerManager ? cmpPlayerManager->GetPlayerByID(owner) : INVALID_ENTITY);
+			if (cmpIdentity)
+				civ->second = CStrW(cmpIdentity->GetCiv()).ToUTF8();
+		}
+		JS::RootedValue templates(rq.cx);
+		JS::RootedValue techTemplate(rq.cx);
+		if (ScriptInterface::GetGlobalProperty(rq, "TechnologyTemplates", &templates))
+			ScriptFunction::Call(rq, templates, "Get", &techTemplate, technology);
+		// As GetTechnologyData without a template: setupButton hides it.
+		if (!techTemplate.isObject())
+			state.flags = PRODUCTION_HIDDEN;
+		else
+		{
+			// GetTechnologyBasicDataHelper's reqs: false when the civ cannot
+			// research it at all.
+			JS::RootedValue global(rq.cx, rq.globalValue());
+			JS::RootedValue reqs(rq.cx);
+			ScriptFunction::Call(rq, global, "DeriveTechnologyRequirements", &reqs, techTemplate, civ->second);
+			JS::RootedValue arg(rq.cx);
+			JS::RootedValue met(rq.cx);
+			Script::CreateObject(rq, &arg, "tech", technology, "player", owner);
+			CallGui(simulation, owner, L"CheckTechnologyRequirements", arg, &met);
+			JS::RootedValue cost(rq.cx);
+			Script::GetProperty(rq, techTemplate, "cost", &cost);
+			state.flags = (Truthy(met) ? PRODUCTION_REQUIREMENTS_MET : 0) |
+				(reqs.isObject() ? 0 : PRODUCTION_HIDDEN);
+			state.costs = ResourceCosts(rq, cost);
+		}
+	}
+	std::vector<std::pair<std::string, float>> costs = state.costs;
+	for (std::pair<std::string, float>& cost : costs)
+	{
+		const auto multiplier = multipliers.find(cost.first);
+		if (multiplier != multipliers.end())
+			cost.second *= multiplier->second;
+	}
+	PutProductionItem(InternString(technology), state.flags | flags, PRODUCTION_NO_LIMIT, costs, out);
+}
