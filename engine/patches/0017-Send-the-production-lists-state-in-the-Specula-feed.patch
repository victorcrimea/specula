+// Population and time are no resources; GetNeededResources skips them, and a
+// cost of 0 is never needed.
+std::vector<std::pair<std::string, float>> ResourceCosts(const ScriptRequest& rq, JS::HandleValue cost)
+{
+	std::vector<std::string> codes;
+	if (cost.isObject())
+		Script::EnumeratePropertyNames(rq, cost, true, codes);
+	std::sort(codes.begin(), codes.end());
+	std::vector<std::pair<std::string, float>> costs;
+	for (const std::string& code : codes)
+	{
+		const float amount = PropertyFloat(rq, cost, code.c_str());
+		if (code != "population" && code != "time" && amount != 0.0f)
+			costs.emplace_back(code, amount);
+	}
+	return costs;
+}
+
+bool CallGui(CSimulation2& simulation, player_id_t player, const std::wstring& name, JS::HandleValue arg, JS::MutableHandleValue ret)
+{
+	CmpPtr<ICmpGuiInterface> cmpGuiInterface(simulation, SYSTEM_ENTITY);
+	if (!cmpGuiInterface)
+		return false;
+	cmpGuiInterface->ScriptCall(player, name, arg, ret);
+	return true;
+}
+
+// The JS component of a player's entity, as QueryPlayerIDInterface.
+IComponent* PlayerComponent(CSimulation2& simulation, const ScriptRequest& rq, player_id_t player, const char* interface)
+{
+	CmpPtr<ICmpPlayerManager> cmpPlayerManager(simulation, SYSTEM_ENTITY);
+	JS::RootedValue iid(rq.cx);
+	if (!cmpPlayerManager || !ScriptInterface::GetGlobalProperty(rq, std::string("IID_") + interface, &iid) || !iid.isInt32())
+		return nullptr;
+	const entity_id_t playerEnt = cmpPlayerManager->GetPlayerByID(player);
+	if (playerEnt == INVALID_ENTITY)
+		return nullptr;
+	return simulation.GetSimContext().GetComponentManager().QueryInterface(playerEnt, iid.toInt32());
+}
+
+// getEntityLimitAndCount's canBeAddedCount (gui/session/input.js), where
+// NaN, as there, is no limit.
+float CanBeAddedCount(CSimulation2& simulation, const ScriptRequest& rq, player_id_t player, const std::string& templateName, JS::HandleValue data)
+{
+	const float none = std::numeric_limits<float>::quiet_NaN();
+	IComponent* limitsComponent = PlayerComponent(simulation, rq, player, "EntityLimits");
+	if (!limitsComponent)
+		return none;
+	JS::RootedValue component(rq.cx, limitsComponent->GetJSInstance());
+	JS::RootedValue restrictions(rq.cx);
+	Script::GetProperty(rq, data, "trainingRestrictions", &restrictions);
+	if (!restrictions.isObject())
+		Script::GetProperty(rq, data, "buildRestrictions", &restrictions);
+	JS::RootedValue categoryValue(rq.cx);
+	Script::GetProperty(rq, restrictions, "category", &categoryValue);
+	const std::string category = StringOf(rq, categoryValue);
+	const float matchLimit = PropertyFloat(rq, restrictions, "matchLimit");
+	if (category.empty() && matchLimit == 0.0f)
+		return none;
+
+	JS::RootedValue limits(rq.cx);
+	JS::RootedValue counts(rq.cx);
+	JS::RootedValue matchCounts(rq.cx);
+	ScriptFunction::Call(rq, component, "GetLimits", &limits);
+	ScriptFunction::Call(rq, component, "GetCounts", &counts);
+	ScriptFunction::Call(rq, component, "GetMatchCounts", &matchCounts);
+	JS::RootedValue limit(rq.cx);
+	if (!category.empty())
+		Script::GetProperty(rq, limits, category.c_str(), &limit);
+
+	float entLimit = none;
+	float entCount = none;
+	float canBeAdded = none;
+	if (!category.empty() && !limit.isUndefined())
+	{
+		entLimit = PropertyFloat(rq, limits, category.c_str());
+		entCount = PropertyFloat(rq, counts, category.c_str());
+		canBeAdded = std::max(entLimit - entCount, 0.0f);
+	}
+	if (matchLimit != 0.0f)
+	{
+		const float matchCount = PropertyFloat(rq, matchCounts, templateName.c_str());
+		// std::max and std::min keep a NaN first argument, as Math does.
+		canBeAdded = std::min(std::max(entLimit - entCount, 0.0f), std::max(matchLimit - matchCount, 0.0f));
+	}
+	return canBeAdded;
+}
+
+u16 LimitOf(float canBeAdded)
+{
+	if (std::isnan(canBeAdded))
+		return PRODUCTION_NO_LIMIT;
+	return static_cast<u16>(std::min(std::floor(canBeAdded), static_cast<float>(PRODUCTION_NO_LIMIT - 1)));
+}
