+#ifndef INCLUDED_SPECULAFEED
+#define INCLUDED_SPECULAFEED
+
+#include "lib/code_annotation.h"
+#include "lib/types.h"
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+class CSimulation2;
+
+/**
+ * Streams a per-turn entity snapshot to the Specula encoder over a Unix
+ * socket. It only reads the simulation, after each turn, so it cannot
+ * change the state hash.
+ *
+ * Feed format v3, little-endian: "SPCF", u32 version, then records of
+ * u8 kind, u32 payload length, payload.
+ *  - kind 1 template: u32 index, u16 name length, UTF-8 name, f32 minimap
+ *    icon size, then the icon file name relative to
+ *    art/textures/ui/session/icons/minimap/ (empty: no icon).
+ *  - kind 2 turn: u32 turn, u32 count, count x {u32 id, u32 template,
+ *    i32 x, i32 z, i32 angle, i32 owner, u8 r, u8 g, u8 b, u8 flags},
+ *    x/z/angle as raw 16.16 fixed. Flag 1: r/g/b is the minimap colour.
+ *  - kind 3 map: u32 map size in metres, once before the first turn.
+ *  - kind 4 terrain, right after the map record: u32 tiles per side n,
+ *    i32 water level (raw 16.16), f32 shallow water depth in metres,
+ *    u8 circular, (n+1)^2 x u16 heights, u32 texture count, count x
+ *    {u16 length, UTF-8 name}, n^2 x u16 texture index (0xFFFF: none).
+ *    Heights and tiles are row-major, x fastest.
+ */
+class CSpeculaFeed
+{
+	NONCOPYABLE(CSpeculaFeed);
+public:
+	CSpeculaFeed(const std::string& socketPath);
+	~CSpeculaFeed();
+
+	void OnTurn(CSimulation2& simulation, u32 turn);
+
+	/**
+	 * Called by CMapReader while loading, which happens before the feed
+	 * exists; the textures are kept until the terrain record is written.
+	 */
+	static void SetTerrainTextures(const std::vector<std::string>& names, std::vector<u16> tiles);
+
+private:
+	void WriteTerrain(CSimulation2& simulation);
+	bool Send();
+	void Disable(const char* what);
+
+	int m_Socket = -1;
+	bool m_MapSent = false;
+	std::vector<u8> m_Buffer;
+	std::unordered_map<std::string, u32> m_TemplateIndices;
+};
+
+#endif // INCLUDED_SPECULAFEED
