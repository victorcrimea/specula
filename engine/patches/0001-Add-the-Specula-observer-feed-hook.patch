+#include "precompiled.h"
+
+#include "SpeculaFeed.h"
+
+#include "graphics/MiniMapTexture.h"
+#include "graphics/Terrain.h"
+#include "ps/CLogger.h"
+#include "simulation2/Simulation2.h"
+#include "simulation2/components/ICmpMinimap.h"
+#include "simulation2/components/ICmpOwnership.h"
+#include "simulation2/components/ICmpPosition.h"
+#include "simulation2/components/ICmpRangeManager.h"
+#include "simulation2/components/ICmpTemplateManager.h"
+#include "simulation2/components/ICmpTerrain.h"
+#include "simulation2/components/ICmpWaterManager.h"
+#include "simulation2/system/CmpPtr.h"
+#include "simulation2/system/Entity.h"
+
+#include <cerrno>
+#include <cstring>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace
+{
+constexpr u32 FEED_VERSION = 3;
+constexpr u8 RECORD_TEMPLATE = 1;
+constexpr u8 RECORD_TURN = 2;
+constexpr u8 RECORD_MAP = 3;
+constexpr u8 RECORD_TERRAIN = 4;
+constexpr u8 COLOR_MINIMAP = 1;
+constexpr u16 NO_TEXTURE = 0xFFFF;
+// CCmpMinimap prepends this to the template's icon file name.
+const std::string ICON_DIRECTORY = "art/textures/ui/session/icons/minimap/";
+
+std::vector<std::string> g_TerrainTextureNames;
+std::vector<u16> g_TerrainTextureTiles;
+
+struct SEntity
+{
+	u32 id;
+	u32 templateIndex;
+	i32 x;
+	i32 z;
+	i32 angle;
+	i32 owner;
+	u8 r;
+	u8 g;
+	u8 b;
+	u8 colorFlags;
+};
+
+void PutU16(std::vector<u8>& buffer, u16 value)
+{
+	buffer.push_back(static_cast<u8>(value));
+	buffer.push_back(static_cast<u8>(value >> 8));
+}
+
+void PutU32(std::vector<u8>& buffer, u32 value)
+{
+	for (int i = 0; i < 4; ++i)
+		buffer.push_back(static_cast<u8>(value >> (8 * i)));
+}
+
+void PutI32(std::vector<u8>& buffer, i32 value)
+{
+	PutU32(buffer, static_cast<u32>(value));
+}
+
+// Returns where the payload starts, for EndRecord to backfill its length.
+size_t BeginRecord(std::vector<u8>& buffer, u8 kind)
+{
+	buffer.push_back(kind);
+	PutU32(buffer, 0);
+	return buffer.size();
+}
+
+void EndRecord(std::vector<u8>& buffer, size_t payloadStart)
+{
+	const u32 length = static_cast<u32>(buffer.size() - payloadStart);
+	for (int i = 0; i < 4; ++i)
+		buffer[payloadStart - 4 + i] = static_cast<u8>(length >> (8 * i));
+}
+} // anonymous namespace
+
+CSpeculaFeed::CSpeculaFeed(const std::string& socketPath)
+{
+	sockaddr_un address{};
+	address.sun_family = AF_UNIX;
+	if (socketPath.size() >= sizeof(address.sun_path))
+	{
+		LOGERROR("Specula feed: socket path too long: %s", socketPath.c_str());
+		return;
+	}
+	std::memcpy(address.sun_path, socketPath.c_str(), socketPath.size());
+
+	m_Socket = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (m_Socket < 0)
+	{
+		Disable("socket");
+		return;
+	}
+	if (connect(m_Socket, reinterpret_cast<const sockaddr*>(&address), sizeof(address)) != 0)
+	{
+		Disable("connect");
+		return;
+	}
+
+	m_Buffer.insert(m_Buffer.end(), { 'S', 'P', 'C', 'F' });
+	PutU32(m_Buffer, FEED_VERSION);
+	Send();
+}
+
+CSpeculaFeed::~CSpeculaFeed()
+{
+	if (m_Socket >= 0)
+		close(m_Socket);
+}
+
+void CSpeculaFeed::OnTurn(CSimulation2& simulation, u32 turn)
+{
+	if (m_Socket < 0)
+		return;
+
+	CmpPtr<ICmpTemplateManager> cmpTemplateManager(simulation, SYSTEM_ENTITY);
+	if (!cmpTemplateManager)
+		return;
+
+	if (!m_MapSent)
+	{
+		CmpPtr<ICmpTerrain> cmpTerrain(simulation, SYSTEM_ENTITY);
+		if (!cmpTerrain)
+			return;
+		const size_t start = BeginRecord(m_Buffer, RECORD_MAP);
+		PutU32(m_Buffer, cmpTerrain->GetMapSize());
+		EndRecord(m_Buffer, start);
+		WriteTerrain(simulation);
+		m_MapSent = true;
+	}
+
+	// Template records must precede the turn record that first uses them,
+	// so the entities are collected before the turn record is written.
+	std::vector<SEntity> entities;
+	for (const std::pair<entity_id_t, IComponent*>& pair : simulation.GetEntitiesWithInterface(IID_Position))
+	{
+		const entity_id_t ent = pair.first;
+		if (ENTITY_IS_LOCAL(ent))
+			continue;
+
+		const ICmpPosition* cmpPosition = static_cast<const ICmpPosition*>(pair.second);
+		if (!cmpPosition->IsInWorld())
+			continue;
+
+		const std::string templateName = cmpTemplateManager->GetCurrentTemplateName(ent);
+		const auto [it, inserted] = m_TemplateIndices.try_emplace(templateName,
+			static_cast<u32>(m_TemplateIndices.size()));
+		if (inserted)
+		{
+			const size_t start = BeginRecord(m_Buffer, RECORD_TEMPLATE);
+			PutU32(m_Buffer, it->second);
+			PutU16(m_Buffer, static_cast<u16>(templateName.size()));
+			m_Buffer.insert(m_Buffer.end(), templateName.begin(), templateName.end());
+			// The icon comes from the template, so every entity of it shares
+			// the first one's.
+			CmpPtr<ICmpMinimap> cmpMinimap(simulation, ent);
+			const bool hasIcon = cmpMinimap && cmpMinimap->HasIcon();
+			const float iconSize = hasIcon ? cmpMinimap->GetIconSize() : 0.0f;
+			u32 iconSizeBits;
+			std::memcpy(&iconSizeBits, &iconSize, sizeof(iconSizeBits));
+			PutU32(m_Buffer, iconSizeBits);
+			if (hasIcon)
+			{
+				std::string icon = cmpMinimap->GetIconPath();
+				if (icon.compare(0, ICON_DIRECTORY.size(), ICON_DIRECTORY) == 0)
+					icon.erase(0, ICON_DIRECTORY.size());
+				m_Buffer.insert(m_Buffer.end(), icon.begin(), icon.end());
+			}
+			EndRecord(m_Buffer, start);
+		}
+
+		CmpPtr<ICmpOwnership> cmpOwnership(simulation, ent);
+		const CFixedVector2D position = cmpPosition->GetPosition2D();
+		SEntity entity{
+			ent,
+			it->second,
+			position.X.GetInternalValue(),
+			position.Y.GetInternalValue(),
+			cmpPosition->GetRotation().Y.GetInternalValue(),
+			cmpOwnership ? cmpOwnership->GetOwner() : INVALID_PLAYER,
+			0, 0, 0, 0
+		};
+		// The minimap colour already resolves owner to player colour and
+		// gives resources their template colour, as the 2D view needs.
+		CmpPtr<ICmpMinimap> cmpMinimap(simulation, ent);
+		entity_pos_t minimapX, minimapZ;
+		if (cmpMinimap && cmpMinimap->GetRenderData(entity.r, entity.g, entity.b, minimapX, minimapZ))
+			entity.colorFlags = COLOR_MINIMAP;
+		entities.push_back(entity);
+	}
+
+	const size_t start = BeginRecord(m_Buffer, RECORD_TURN);
+	PutU32(m_Buffer, turn);
+	PutU32(m_Buffer, static_cast<u32>(entities.size()));
+	for (const SEntity& entity : entities)
+	{
+		PutU32(m_Buffer, entity.id);
+		PutU32(m_Buffer, entity.templateIndex);
+		PutI32(m_Buffer, entity.x);
+		PutI32(m_Buffer, entity.z);
+		PutI32(m_Buffer, entity.angle);
+		PutI32(m_Buffer, entity.owner);
+		m_Buffer.insert(m_Buffer.end(), { entity.r, entity.g, entity.b, entity.colorFlags });
+	}
+	EndRecord(m_Buffer, start);
+
+	Send();
+}
+
+void CSpeculaFeed::SetTerrainTextures(const std::vector<std::string>& names, std::vector<u16> tiles)
+{
+	g_TerrainTextureNames = names;
+	g_TerrainTextureTiles = std::move(tiles);
+}
+
+// Terrain and water level are written once: they only change through
+// trigger scripts, which the view does not follow yet.
+void CSpeculaFeed::WriteTerrain(CSimulation2& simulation)
+{
+	CmpPtr<ICmpTerrain> cmpTerrain(simulation, SYSTEM_ENTITY);
+	const CTerrain* terrain = cmpTerrain ? cmpTerrain->GetCTerrain() : nullptr;
+	if (!terrain)
+		return;
+	CmpPtr<ICmpWaterManager> cmpWaterManager(simulation, SYSTEM_ENTITY);
+	CmpPtr<ICmpRangeManager> cmpRangeManager(simulation, SYSTEM_ENTITY);
+
+	const size_t tilesPerSide = static_cast<size_t>(terrain->GetTilesPerSide());
+	const size_t verticesPerSide = static_cast<size_t>(terrain->GetVerticesPerSide());
+	// A map whose tiles were never captured still gets its relief, like the
+	// minimap draws a tile without a texture.
+	const bool haveTextures = g_TerrainTextureTiles.size() == tilesPerSide * tilesPerSide;
+
+	const size_t start = BeginRecord(m_Buffer, RECORD_TERRAIN);
+	PutU32(m_Buffer, static_cast<u32>(tilesPerSide));
+	PutI32(m_Buffer, cmpWaterManager ? cmpWaterManager->GetWaterLevel(entity_pos_t::Zero(), entity_pos_t::Zero()).GetInternalValue() : 0);
+	const float shallowDepth = CMiniMapTexture::GetShallowPassageHeight();
+	u32 shallowBits;
+	std::memcpy(&shallowBits, &shallowDepth, sizeof(shallowBits));
+	PutU32(m_Buffer, shallowBits);
+	m_Buffer.push_back(cmpRangeManager && cmpRangeManager->GetLosCircular() ? 1 : 0);
+
+	const u16* heights = terrain->GetHeightMap();
+	for (size_t i = 0; i < verticesPerSide * verticesPerSide; ++i)
+		PutU16(m_Buffer, heights[i]);
+
+	PutU32(m_Buffer, haveTextures ? static_cast<u32>(g_TerrainTextureNames.size()) : 0);
+	if (haveTextures)
+		for (const std::string& name : g_TerrainTextureNames)
+		{
+			PutU16(m_Buffer, static_cast<u16>(name.size()));
+			m_Buffer.insert(m_Buffer.end(), name.begin(), name.end());
+		}
+	for (size_t i = 0; i < tilesPerSide * tilesPerSide; ++i)
+		PutU16(m_Buffer, haveTextures ? g_TerrainTextureTiles[i] : NO_TEXTURE);
+	EndRecord(m_Buffer, start);
+}
+
+bool CSpeculaFeed::Send()
+{
+	size_t sent = 0;
+	while (sent < m_Buffer.size())
+	{
+		// MSG_NOSIGNAL: a vanished encoder must not kill the observer with
+		// SIGPIPE, the feed just stops.
+		const ssize_t result = send(m_Socket, m_Buffer.data() + sent, m_Buffer.size() - sent, MSG_NOSIGNAL);
+		if (result < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			Disable("send");
+			return false;
+		}
+		sent += static_cast<size_t>(result);
+	}
+	m_Buffer.clear();
+	return true;
+}
+
+void CSpeculaFeed::Disable(const char* what)
+{
+	LOGERROR("Specula feed: %s failed: %s, feed disabled", what, std::strerror(errno));
+	if (m_Socket >= 0)
+		close(m_Socket);
+	m_Socket = -1;
+	m_Buffer.clear();
+}
