+// Only Foundation.js sets one, to its builder count, so the distinct sets
+// of a match are few, as with variants.
+u32 CSpeculaFeed::InternVariables(const std::map<std::string, float>& variables)
+{
+	std::vector<std::pair<u32, u32>> pairs;
+	for (const std::pair<const std::string, float>& variable : variables)
+	{
+		u32 bits;
+		std::memcpy(&bits, &variable.second, sizeof(bits));
+		pairs.emplace_back(InternString(variable.first), bits);
+	}
+	if (pairs.empty())
+		return NONE;
+	const auto [it, inserted] = m_VariableSetIndices.try_emplace(pairs, static_cast<u32>(m_VariableSetIndices.size()));
+	if (inserted)
+	{
+		const size_t start = BeginRecord(m_Buffer, RECORD_VARIABLE_SET);
+		PutU32(m_Buffer, it->second);
+		PutU32(m_Buffer, static_cast<u32>(pairs.size()));
+		for (const std::pair<u32, u32>& pair : pairs)
+		{
+			PutU32(m_Buffer, pair.first);
+			PutU32(m_Buffer, pair.second);
+		}
+		EndRecord(m_Buffer, start);
+	}
+	return it->second;
+}
