From e9cd355df2396aa54c57bfc340b673773523d91c Mon Sep 17 00:00:00 2001
From: Viktor Semenov <suit.uanic@gmail.com>
Date: Tue, 20 Oct 2026 13:04:31 +0000
Subject: [PATCH 13/45] Leave fog-of-war mirages out of the Specula feed

Fogging.js adds mirages with AddEntity, so they are global entities and
the local-entity filter did not skip them. On a map without a revealed
map the observer saw a copy of every tree, building or unit a player had
last seen in the fog, and the copy stayed after the real entity was gone.
---
 source/network/SpeculaFeed.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/source/network/SpeculaFeed.cpp b/source/network/SpeculaFeed.cpp
index 86320c447e..0b42811830 100644
--- a/source/network/SpeculaFeed.cpp
+++ b/source/network/SpeculaFeed.cpp
@@ -35,6 +35,7 @@
 #include "simulation2/Simulation2.h"
 #include "simulation2/components/ICmpGuiInterface.h"
 #include "simulation2/components/ICmpMinimap.h"
+#include "simulation2/components/ICmpMirage.h"
 #include "simulation2/components/ICmpOwnership.h"
 #include "simulation2/components/ICmpPlayerManager.h"
 #include "simulation2/components/ICmpPosition.h"
@@ -145,7 +146,8 @@ const std::string ICON_DIRECTORY = "art/textures/ui/session/icons/minimap/";
 // The local entities a viewer has to see: Foundation.js shows the rising
 // building as one, and Health.js leaves corpses and the rubble of
 // SpawnEntityOnDeath as others, which carry the destruction particles.
-// Mirages and placement previews stay out.
+// Placement previews stay out. So do mirages, which Fogging.js adds as
+// global entities, so they are told apart by their component, not by id.
 const std::array<std::string_view, 3> LOCAL_PREFIXES = { "construction|", "corpse|", "decay|" };
 // SelectAnimation mirrors the animation name into this variant key.
 const CStr ANIMATION_KEY = "animation";
@@ -373,6 +375,13 @@ void CSpeculaFeed::OnTurn(CSimulation2& simulation, u32 turn)
 		if (!cmpPosition->IsInWorld())
 			continue;
 
+		// A mirage is what one player last saw of an entity in the fog; the
+		// observer sees the entity itself, so the copy would stay on after it
+		// is gone.
+		CmpPtr<ICmpMirage> cmpMirage(simulation, ent);
+		if (cmpMirage)
+			continue;
+
 		const std::string templateName = cmpTemplateManager->GetCurrentTemplateName(ent);
 		if (ENTITY_IS_LOCAL(ent) && std::none_of(LOCAL_PREFIXES.begin(), LOCAL_PREFIXES.end(),
 			[&templateName](std::string_view prefix) { return templateName.compare(0, prefix.size(), prefix) == 0; }))
