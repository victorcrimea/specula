From e774ed969653c6ee4a454fe98a475de14d6bf7ae Mon Sep 17 00:00:00 2001
From: Viktor Semenov <suit.uanic@gmail.com>
Date: Thu, 8 Oct 2026 01:47:15 +0000
Subject: [PATCH 10/45] Send the map's water and sky in the Specula feed

CMapReader gives the water colour, tint, waviness, murkiness, wind angle
and type to the renderer's WaterManager, and the sky set to SkyManager,
both absent in nonvisual mode. It now also writes them to the feed's
environment, reset to WaterManager's defaults and no sky at every map
load, and the terrain record (feed v13) carries them after the post
effect.
---
 source/graphics/MapReader.cpp  | 36 ++++++++++++++++++++++++++++++++++
 source/network/SpeculaFeed.cpp | 28 +++++++++++++++++++++++++-
 source/network/SpeculaFeed.h   | 34 +++++++++++++++++++++++++++++---
 3 files changed, 94 insertions(+), 4 deletions(-)

diff --git a/source/graphics/MapReader.cpp b/source/graphics/MapReader.cpp
index f81555861c..dd77d909cd 100644
--- a/source/graphics/MapReader.cpp
+++ b/source/graphics/MapReader.cpp
@@ -150,6 +150,7 @@ void CMapReader::LoadMap(const VfsPath& pathname, const ScriptContext& cx,  JS::
 	if (pPostproc)
 		pPostproc->SetPostEffect(L"default");
 	CSpeculaFeed::SetPostEffect(L"default");
+	CSpeculaFeed::ResetEnvironment();
 
 	// load map or script settings script
 	if (settings.isUndefined())
@@ -740,6 +741,7 @@ void CXMLReader::ReadEnvironment(XMBElement parent)
 
 		if (element_name == el_skyset)
 		{
+			CSpeculaFeed::Environment().skySet = element.GetText().FromUTF8();
 			if (m_MapReader.pSkyMan)
 				m_MapReader.pSkyMan->SetSkySet(element.GetText().FromUTF8());
 		}
@@ -833,6 +835,29 @@ void CXMLReader::ReadEnvironment(XMBElement parent)
 						continue;
 					}
 
+					CSpeculaFeed::SEnvironment& feed = CSpeculaFeed::Environment();
+					const auto readColor = [&]()
+					{
+						XMBAttributeList colorAttrs = waterelement.GetAttributes();
+						return CColor(
+							colorAttrs.GetNamedItem(at_r).ToFloat(),
+							colorAttrs.GetNamedItem(at_g).ToFloat(),
+							colorAttrs.GetNamedItem(at_b).ToFloat(),
+							1.f);
+					};
+					if (water_element_name == el_type)
+						feed.waterType = waterelement.GetText() == "default" ? L"ocean" : waterelement.GetText().FromUTF8();
+					else if (water_element_name == el_color)
+						feed.waterColor = readColor();
+					else if (water_element_name == el_tint)
+						feed.waterTint = readColor();
+					else if (water_element_name == el_waviness)
+						feed.waviness = waterelement.GetText().ToFloat();
+					else if (water_element_name == el_murkiness)
+						feed.murkiness = waterelement.GetText().ToFloat();
+					else if (water_element_name == el_windangle)
+						feed.windAngle = waterelement.GetText().ToFloat();
+
 					// The rest are purely graphical effects, and should be ignored if
 					// graphics are disabled
 					if (!m_MapReader.pWaterMan)
@@ -1646,6 +1671,7 @@ int CMapReader::ParseEnvironment()
 
 	std::wstring skySet;
 	GET_ENVIRONMENT_PROPERTY(envObj, SkySet, skySet)
+	CSpeculaFeed::Environment().skySet = skySet;
 	if (pSkyMan)
 		pSkyMan->SetSkySet(skySet);
 
@@ -1688,6 +1714,16 @@ int CMapReader::ParseEnvironment()
 		GET_ENVIRONMENT_PROPERTY(waterBodyObj, WindAngle, pWaterMan->m_WindAngle)
 	}
 
+	CSpeculaFeed::SEnvironment& feed = CSpeculaFeed::Environment();
+	GET_ENVIRONMENT_PROPERTY(waterBodyObj, Type, feed.waterType)
+	if (feed.waterType == L"default")
+		feed.waterType = L"ocean";
+	GET_ENVIRONMENT_PROPERTY(waterBodyObj, Color, feed.waterColor)
+	GET_ENVIRONMENT_PROPERTY(waterBodyObj, Tint, feed.waterTint)
+	GET_ENVIRONMENT_PROPERTY(waterBodyObj, Waviness, feed.waviness)
+	GET_ENVIRONMENT_PROPERTY(waterBodyObj, Murkiness, feed.murkiness)
+	GET_ENVIRONMENT_PROPERTY(waterBodyObj, WindAngle, feed.windAngle)
+
 	JS::RootedValue fogObject(rq.cx);
 	GET_ENVIRONMENT_PROPERTY(envObj, Fog, &fogObject);
 
diff --git a/source/network/SpeculaFeed.cpp b/source/network/SpeculaFeed.cpp
index adaa53b9ac..8eb95671b7 100644
--- a/source/network/SpeculaFeed.cpp
+++ b/source/network/SpeculaFeed.cpp
@@ -56,7 +56,7 @@
 
 namespace
 {
-constexpr u32 FEED_VERSION = 12;
+constexpr u32 FEED_VERSION = 13;
 constexpr u8 RECORD_TEMPLATE = 1;
 constexpr u8 RECORD_TURN = 2;
 constexpr u8 RECORD_MAP = 3;
@@ -106,6 +106,7 @@ std::vector<std::string> g_TerrainTextureNames;
 std::vector<u16> g_TerrainTextureTiles;
 std::vector<u32> g_TerrainTexturePriorities;
 std::string g_PostEffect = "default";
+CSpeculaFeed::SEnvironment g_Environment;
 
 struct SEntity
 {
@@ -419,6 +420,16 @@ void CSpeculaFeed::SetPostEffect(const std::wstring& name)
 	g_PostEffect = utf8_from_wstring(name);
 }
 
+void CSpeculaFeed::ResetEnvironment()
+{
+	g_Environment = SEnvironment();
+}
+
+CSpeculaFeed::SEnvironment& CSpeculaFeed::Environment()
+{
+	return g_Environment;
+}
+
 // Mirrors the test CCmpSoundManager::PlaySoundGroup makes for the displayed
 // player, for every player at once.
 u16 CSpeculaFeed::Visibility(const CSimContext& context, entity_id_t ent)
@@ -709,6 +720,21 @@ void CSpeculaFeed::WriteTerrain(CSimulation2& simulation)
 	PutF32(m_Buffer, g_LightEnv.m_Bloom);
 	PutU16(m_Buffer, static_cast<u16>(g_PostEffect.size()));
 	m_Buffer.insert(m_Buffer.end(), g_PostEffect.begin(), g_PostEffect.end());
+	for (const CColor& color : { g_Environment.waterColor, g_Environment.waterTint })
+	{
+		PutF32(m_Buffer, color.r);
+		PutF32(m_Buffer, color.g);
+		PutF32(m_Buffer, color.b);
+	}
+	PutF32(m_Buffer, g_Environment.waviness);
+	PutF32(m_Buffer, g_Environment.murkiness);
+	PutF32(m_Buffer, g_Environment.windAngle);
+	for (const std::wstring& name : { g_Environment.waterType, g_Environment.skySet })
+	{
+		const std::string utf8 = utf8_from_wstring(name);
+		PutU16(m_Buffer, static_cast<u16>(utf8.size()));
+		m_Buffer.insert(m_Buffer.end(), utf8.begin(), utf8.end());
+	}
 
 	const u16* heights = terrain->GetHeightMap();
 	for (size_t i = 0; i < verticesPerSide * verticesPerSide; ++i)
