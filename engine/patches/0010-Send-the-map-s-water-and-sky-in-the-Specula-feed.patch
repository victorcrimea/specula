 	 */
 	static void SetPostEffect(const std::wstring& name);
 
+	/**
+	 * What CMapReader gives the renderer's WaterManager and SkyManager,
+	 * both absent in nonvisual mode, so it writes them here as well.
+	 */
+	struct SEnvironment
+	{
+		// WaterManager's constructor; SkyManager starts without a set.
+		std::wstring waterType = L"ocean";
+		CColor waterColor = CColor(0.3f, 0.35f, 0.7f, 1.0f);
+		CColor waterTint = CColor(0.28f, 0.3f, 0.59f, 1.0f);
+		float waviness = 8.0f;
+		float murkiness = 0.45f;
+		float windAngle = 0.0f;
+		std::wstring skySet;
+	};
+
+	/**
+	 * Sets WaterManager's and SkyManager's initial values, as a map leaves
+	 * unset what it does not name.
+	 */
+	static void ResetEnvironment();
+	static SEnvironment& Environment();
+
 	/**
 	 * Called by CCmpSoundManager, which plays nothing in nonvisual mode;
 	 * the sounds go out with the turn they were played in. No-ops when no
