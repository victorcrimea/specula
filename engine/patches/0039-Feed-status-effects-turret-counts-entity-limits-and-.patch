+				Script::GetProperty(rq, status, "baseCode", &baseCode);
+				Script::GetProperty(rq, status, "_timeElapsed", &elapsed);
+				JS::RootedValue trimmed(rq.cx);
+				Script::CreateObject(rq, &trimmed);
+				std::vector<std::string> keys;
+				Script::EnumeratePropertyNames(rq, status, true, keys);
+				std::sort(keys.begin(), keys.end());
