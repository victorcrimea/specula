+// A foundation has no Attack component, so the range its finished structure
+// will have is read from the final template, with the owner's modifiers as
+// the build tooltip shows them.
+void CSpeculaFeed::PutFutureRanges(CSimulation2& simulation, const ScriptRequest& rq, entity_id_t ent, JS::HandleValue component, bool sampleLists, std::map<std::pair<std::string, player_id_t>, std::vector<u8>>& cache, SDetailGroups& groups)
+{
+	const size_t slot = DETAIL_RANGES;
+	if (!sampleLists)
+	{
+		const auto last = m_LastDetails.find(ent);
+		if (last != m_LastDetails.end() && groups[slot].empty())
+			groups[slot] = last->second[slot];
+		return;
+	}
+	CmpPtr<ICmpOwnership> cmpOwnership(simulation, ent);
+	if (!cmpOwnership || cmpOwnership->GetOwner() == INVALID_PLAYER)
+		return;
+	const player_id_t owner = cmpOwnership->GetOwner();
+	std::string finalName;
+	Script::GetProperty(rq, component, "finalTemplateName", finalName);
+	if (finalName.empty())
+		return;
+
+	const auto [it, inserted] = cache.try_emplace(std::make_pair(finalName, owner));
+	if (inserted)
+	{
+		CmpPtr<ICmpTemplateManager> cmpTemplateManager(simulation, SYSTEM_ENTITY);
+		const CParamNode* node = cmpTemplateManager ? cmpTemplateManager->GetTemplate(finalName) : nullptr;
+		if (node)
+		{
+			const CParamNode& overlay = node->GetChild("Attack").GetChild("Ranged").GetChild("RangeOverlay");
+			if (overlay.IsOk())
+			{
+				JS::RootedValue arg(rq.cx);
+				JS::RootedValue data(rq.cx);
+				Script::CreateObject(rq, &arg, "templateName", finalName, "player", owner);
+				CallGui(simulation, owner, L"GetTemplateData", arg, &data);
+				JS::RootedValue attack(rq.cx);
+				JS::RootedValue ranged(rq.cx);
+				if (data.isObject())
+					Script::GetProperty(rq, data, "attack", &attack);
+				if (attack.isObject())
+					Script::GetProperty(rq, attack, "Ranged", &ranged);
+				if (ranged.isObject())
+				{
+					// The order of Attack.GetRange's keys.
+					for (const char* key : {"maxRange", "minRange"})
+					{
+						const float radius = PropertyFloat(rq, ranged, key);
+						if (!(radius > 0.0f))
+							continue;
+						it->second.push_back(RANGE_FUTURE_ATTACK);
+						PutF32(it->second, radius);
+						PutU32(it->second, InternString(overlay.GetChild("LineTexture").ToString()));
+						PutU32(it->second, InternString(overlay.GetChild("LineTextureMask").ToString()));
+						PutF32(it->second, overlay.GetChild("LineThickness").ToFloat());
+					}
+				}
+			}
+		}
+	}
+	if (it->second.empty())
+		return;
+	std::vector<u8>& group = groups[slot];
+	if (group.empty())
+		group.push_back(0);
+	// Each circle is 17 bytes: type, radius, texture, mask, thickness.
+	const size_t circles = it->second.size() / 17;
+	group[0] = static_cast<u8>(std::min<size_t>(group[0] + circles, 0xFF));
+	group.insert(group.end(), it->second.begin(), it->second.end());
+}
