+// The preview's attack range, which vanilla's RangeOverlayManager draws round
+// it; the reply is the only way it reaches the client.
+void AddPreviewRanges(CSimulation2& simulation, const ScriptRequest& rq, JS::HandleValue result)
+{
+	if (!result.isObject())
+		return;
+	CmpPtr<ICmpGuiInterface> cmpGuiInterface(simulation, SYSTEM_ENTITY);
+	if (!cmpGuiInterface)
+		return;
+	JS::RootedValue gui(rq.cx, cmpGuiInterface->GetJSInstance());
+	JS::RootedValue placement(rq.cx);
+	if (!Script::GetProperty(rq, gui, "placementEntity", &placement) || !placement.isObject())
+		return;
+	int entValue = 0;
+	if (!Script::GetPropertyInt(rq, placement, 1, entValue))
+		return;
+	JS::RootedValue iid(rq.cx);
+	if (!ScriptInterface::GetGlobalProperty(rq, "IID_Attack", &iid) || !iid.isInt32())
+		return;
+	IComponent* attack = simulation.GetSimContext().GetComponentManager().QueryInterface(static_cast<entity_id_t>(entValue), iid.toInt32());
+	if (!attack)
+		return;
+	JS::RootedValue component(rq.cx, attack->GetJSInstance());
+	JS::RootedValue overlays(rq.cx);
+	if (ScriptFunction::Call(rq, component, "GetRangeOverlays", &overlays))
+		Script::SetProperty(rq, result, "ranges", overlays);
+}
