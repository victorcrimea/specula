+void CSpeculaFeed::NoteProjectileShooter(entity_id_t ent)
+{
+	if (g_SoundFeed)
+		g_SoundFeed->m_Shooter = ent;
+}
+
+void CSpeculaFeed::RecordProjectileLaunch(u32 id, const CFixedVector3D& launchPoint, const CFixedVector3D& target, fixed speed, fixed gravity, const std::wstring& actorName, const std::wstring& impactActorName, fixed impactAnimationLifetime)
+{
+	if (!g_SoundFeed)
+		return;
+	g_SoundFeed->m_Launches.push_back({
+		id,
+		g_SoundFeed->m_Shooter,
+		launchPoint.X.GetInternalValue(),
+		launchPoint.Y.GetInternalValue(),
+		launchPoint.Z.GetInternalValue(),
+		target.X.GetInternalValue(),
+		target.Y.GetInternalValue(),
+		target.Z.GetInternalValue(),
+		speed.GetInternalValue(),
+		gravity.GetInternalValue(),
+		g_SoundFeed->InternString(utf8_from_wstring(actorName)),
+		g_SoundFeed->InternString(utf8_from_wstring(impactActorName)),
+		impactAnimationLifetime.GetInternalValue()
+	});
+	g_SoundFeed->m_Shooter = INVALID_ENTITY;
+}
+
+void CSpeculaFeed::RecordProjectileRemove(u32 id)
+{
+	if (g_SoundFeed)
+		g_SoundFeed->m_Removals.push_back(id);
+}
