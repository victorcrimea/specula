From af9d73a93405be3ea1407be5f1975ed290045ab9 Mon Sep 17 00:00:00 2001
From: Viktor Semenov <suit.uanic@gmail.com>
Date: Wed, 21 Oct 2026 15:09:20 +0000
Subject: [PATCH 19/45] Send the builders' lists in the Specula feed

Kind 12 group 4194304 names a kind 17 list of Builder.GetEntitiesList,
each item read for the owner as a trainable one (the construction panel
reads them so, without the batch), sampled with the other production
lists. Kind 18 also sends the template data of every buildable item. A
new group bit, so the feed stays v14.
---
 source/network/SpeculaFeed.cpp | 14 +++++++++-----
 source/network/SpeculaFeed.h   | 26 +++++++++++++++-----------
 2 files changed, 24 insertions(+), 16 deletions(-)

diff --git a/source/network/SpeculaFeed.cpp b/source/network/SpeculaFeed.cpp
index 7283adedb6..37bb4bad1b 100644
--- a/source/network/SpeculaFeed.cpp
+++ b/source/network/SpeculaFeed.cpp
@@ -129,6 +129,7 @@ constexpr size_t DETAIL_TRAINABLE = 18;
 constexpr size_t DETAIL_RESEARCHABLE = 19;
 constexpr size_t DETAIL_RALLY = 20;
 constexpr size_t DETAIL_STATS = 21;
+constexpr size_t DETAIL_BUILDABLE = 22;
 constexpr u8 PRODUCTION_REQUIREMENTS_MET = 1;
 constexpr u8 PRODUCTION_HIDDEN = 2;
 constexpr u8 PRODUCTION_PAIR_TOP = 4;
@@ -146,7 +147,7 @@ const char* const DETAIL_INTERFACES[] = {
 	"Health", "Capturable", "ResourceSupply", "ProductionQueue", "GarrisonHolder",
 	"Promotion", "ResourceGatherer", "Foundation", "Repairable", "UnitAI", "Trainer",
 	"Researcher", "Pack", "Upgrade", "Trader", "Garrisonable", "Turretable", "Attack", "Auras",
-	"Heal", "RallyPoint"
+	"Heal", "RallyPoint", "Builder"
 };
 // Indices of DETAIL_INTERFACES that are read together.
 constexpr size_t INTERFACE_PACK = 12;
@@ -1598,9 +1599,10 @@ void CSpeculaFeed::WriteDetails(CSimulation2& simulation, u32 turn)
 				PutU32(group, InternString(StringOf(rq, stance)));
 				PutU32(group, static_cast<u32>(CallFloat(rq, component, "GetFormationController")));
 			}
-			else if (interface == "Trainer" || interface == "Researcher")
+			else if (interface == "Trainer" || interface == "Researcher" || interface == "Builder")
 			{
-				const size_t slot = interface == "Trainer" ? DETAIL_TRAINABLE : DETAIL_RESEARCHABLE;
+				const size_t slot = interface == "Trainer" ? DETAIL_TRAINABLE
+					: interface == "Researcher" ? DETAIL_RESEARCHABLE : DETAIL_BUILDABLE;
 				if (!sampleLists)
 				{
 					const auto last = m_LastDetails.find(ent);
@@ -1609,7 +1611,7 @@ void CSpeculaFeed::WriteDetails(CSimulation2& simulation, u32 turn)
 					continue;
 				}
 				JS::RootedValue list(rq.cx);
-				ScriptFunction::Call(rq, component, interface == "Trainer" ? "GetEntitiesList" : "GetTechnologiesList", &list);
+				ScriptFunction::Call(rq, component, interface == "Researcher" ? "GetTechnologiesList" : "GetEntitiesList", &list);
 				CmpPtr<ICmpOwnership> cmpOwnership(simulation, ent);
 				const player_id_t owner = cmpOwnership ? cmpOwnership->GetOwner() : INVALID_PLAYER;
 				std::map<std::string, float> multipliers;
@@ -1642,7 +1644,9 @@ void CSpeculaFeed::WriteDetails(CSimulation2& simulation, u32 turn)
 						PutProductionItem(InternString(name), PRODUCTION_REQUIREMENTS_MET, PRODUCTION_NO_LIMIT, {}, items);
 						++count;
 					}
-					else if (interface == "Trainer")
+					// The construction panel reads its items as the training
+					// panel does, without the batch.
+					else if (interface != "Researcher")
 					{
 						PutTrainable(simulation, rq, owner, name, productionCache, items);
 						++count;
