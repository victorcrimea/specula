+// Read through the GUI interface, as the session GUI does every turn: team
+// and diplomacy live only in JS components.
+void CSpeculaFeed::WritePlayers(CSimulation2& simulation)
+{
+	CmpPtr<ICmpGuiInterface> cmpGuiInterface(simulation, SYSTEM_ENTITY);
+	if (!cmpGuiInterface)
+		return;
+
+	ScriptRequest rq(simulation.GetScriptInterface());
+	JS::RootedValue arg(rq.cx);
+	JS::RootedValue simulationState(rq.cx);
+	cmpGuiInterface->ScriptCall(INVALID_PLAYER, L"GetSimulationState", arg, &simulationState);
+	JS::RootedValue players(rq.cx);
+	u32 count = 0;
+	if (!Script::GetProperty(rq, simulationState, "players", &players) ||
+	    !Script::GetProperty(rq, players, "length", count))
+		return;
+
+	std::vector<u8> payload;
+	PutU32(payload, count);
+	for (u32 i = 0; i < count; ++i)
+	{
+		JS::RootedValue player(rq.cx);
+		JS::RootedValue color(rq.cx);
+		JS::RootedValue allies(rq.cx);
+		JS::RootedValue neutrals(rq.cx);
+		std::string name;
+		std::string state;
+		float r, g, b;
+		i32 team;
+		if (!Script::GetPropertyInt(rq, players, static_cast<int>(i), &player) ||
+		    !Script::GetProperty(rq, player, "name", name) ||
+		    !Script::GetProperty(rq, player, "color", &color) ||
+		    !Script::GetProperty(rq, color, "r", r) ||
+		    !Script::GetProperty(rq, color, "g", g) ||
+		    !Script::GetProperty(rq, color, "b", b) ||
+		    !Script::GetProperty(rq, player, "team", team) ||
+		    !Script::GetProperty(rq, player, "state", state) ||
+		    !Script::GetProperty(rq, player, "isAlly", &allies) ||
+		    !Script::GetProperty(rq, player, "isNeutral", &neutrals))
+			return;
+
+		PutU16(payload, static_cast<u16>(name.size()));
+		payload.insert(payload.end(), name.begin(), name.end());
+		// Quantized like CCmpMinimap::UpdateColor, so an undiplomatic
+		// palette gives the very colours of the dots.
+		payload.insert(payload.end(), {
+			static_cast<u8>(r * 255),
+			static_cast<u8>(g * 255),
+			static_cast<u8>(b * 255)
+		});
+		PutI32(payload, team);
+		payload.push_back(state == "active" ? PLAYER_ACTIVE : state == "won" ? PLAYER_WON : PLAYER_DEFEATED);
+		for (u32 j = 0; j < count; ++j)
+		{
+			bool ally = false;
+			bool neutral = false;
+			if (!Script::GetPropertyInt(rq, allies, static_cast<int>(j), ally) ||
+			    !Script::GetPropertyInt(rq, neutrals, static_cast<int>(j), neutral))
+				return;
+			// The GUI tests alliance first, then neutrality.
+			payload.push_back(ally ? STANCE_ALLY : neutral ? STANCE_NEUTRAL : STANCE_ENEMY);
+		}
+	}
+
+	if (payload == m_LastPlayers)
+		return;
+	const size_t start = BeginRecord(m_Buffer, RECORD_PLAYERS);
+	m_Buffer.insert(m_Buffer.end(), payload.begin(), payload.end());
+	EndRecord(m_Buffer, start);
+	m_LastPlayers = std::move(payload);
+}
