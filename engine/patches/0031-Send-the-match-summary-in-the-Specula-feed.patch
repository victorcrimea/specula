 }
 
+// One GetExtendedSimulationState costs a lot (the team exploration is
+// computed from scratch), so the full copy and every seat's filtered copy
+// come from a single call.
+bool CSpeculaFeed::WriteSummary(CSimulation2& simulation, u32 turn, bool isFinal)
+{
+	ScriptRequest rq(simulation.GetScriptInterface());
+	JS::RootedValue arg(rq.cx);
+	JS::RootedValue result(rq.cx);
+	if (!CallGui(simulation, INVALID_PLAYER, L"GetSpeculaSummaries", arg, &result))
+		return false;
+	const u32 count = std::min<u32>(ArrayLength(rq, result), 0xFF);
+	if (count == 0)
+		return false;
+
+	std::vector<std::string> views;
+	for (u32 i = 0; i < count; ++i)
+	{
+		JS::RootedValue element(rq.cx);
+		if (!Script::GetPropertyInt(rq, result, static_cast<int>(i), &element))
+			return false;
+		std::string json = Script::StringifyJSON(rq, &element, false);
+		if (json.empty())
+			return false;
+		views.push_back(std::move(json));
+	}
+
+	const size_t start = BeginRecord(m_Buffer, RECORD_SUMMARY);
+	PutU32(m_Buffer, turn);
+	m_Buffer.push_back(isFinal ? 1 : 0);
+	m_Buffer.push_back(static_cast<u8>(views.size()));
+	for (u32 i = 0; i < views.size(); ++i)
+	{
+		m_Buffer.push_back(static_cast<u8>(i));
+		PutU32(m_Buffer, static_cast<u32>(views[i].size()));
+		m_Buffer.insert(m_Buffer.end(), views[i].begin(), views[i].end());
+	}
+	EndRecord(m_Buffer, start);
+	return true;
+}
