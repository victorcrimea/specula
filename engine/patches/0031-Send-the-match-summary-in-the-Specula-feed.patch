+	// After the turn record, so the server has already named the match, and
+	// before Send(), so the final copy reaches it before the feed closes.
+	const bool isFinal = g_Game && g_Game->IsGameFinished();
+	const bool periodic = !m_HasSummary || turn >= m_NextSummaryTurn;
+	if (!m_FinalSummarySent && (isFinal || m_SummaryRequested || periodic))
+	{
+		if (WriteSummary(simulation, turn, isFinal))
+		{
+			m_HasSummary = true;
+			m_NextSummaryTurn = turn + SUMMARY_INTERVAL_TURNS;
+			m_SummaryRequested = false;
+			if (isFinal)
+				m_FinalSummarySent = true;
+		}
+	}
