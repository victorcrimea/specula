+/**
+ * The replay metadata, once with every player and once per player with only
+ * what that player may see in the summary (Gaia, the player and the mutual
+ * allies it shares LOS with, as gui/session/MenuButtons.js). The extended
+ * state is read once because it is costly; nothing is changed.
+ */
+GuiInterface.prototype.GetSpeculaSummaries = function()
+{
+	const extended = this.GetExtendedSimulationState();
+	const summaries = [{
+		"timeElapsed": extended.timeElapsed,
+		"playerStates": extended.players,
+		"mapSettings": InitAttributes.settings
+	}];
+	for (let seat = 1; seat < extended.players.length; ++seat)
+	{
+		const included = [];
+		for (let p = 0; p < extended.players.length; ++p)
+			if (p == 0 || p == seat ||
+				extended.players[seat].hasSharedLos && extended.players[p].isMutualAlly[seat])
+				included.push(p);
+		summaries.push({
+			"timeElapsed": extended.timeElapsed,
+			"playerStates": included.map(p => extended.players[p]),
+			"playerIDs": included,
+			"mapSettings": InitAttributes.settings
+		});
+	}
+	return summaries;
+};
+
 /**
  * Called when the game ends if the current game is part of a campaign run.
  */
