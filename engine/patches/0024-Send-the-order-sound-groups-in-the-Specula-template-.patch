From f7c6a741fe7674bf6821cad8bf34137c6fa57139 Mon Sep 17 00:00:00 2001
From: Viktor Semenov <suit.uanic@gmail.com>
Date: Tue, 10 Nov 2026 11:52:34 +0000
Subject: [PATCH 24/45] Send the order sound groups in the Specula template
 details

Kind 11 now ends with a string of the template's Sound groups that
gui/session plays on giving an order: order_*, focus_fire and
invalid_building_placement, as space separated "name=path" tokens, so
the web client can play an order's confirmation sound as PlaySound
does. An older hook ends before it; the feed stays v14.
---
 source/network/SpeculaFeed.cpp | 8 ++++++++
 source/network/SpeculaFeed.h   | 5 ++++-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/source/network/SpeculaFeed.cpp b/source/network/SpeculaFeed.cpp
index 37ef4741a2..ea536dbf70 100644
--- a/source/network/SpeculaFeed.cpp
+++ b/source/network/SpeculaFeed.cpp
@@ -1402,6 +1402,13 @@ void CSpeculaFeed::WriteTemplateDetails(CSimulation2& simulation, u32 index, con
 			attackTypes += separator + restrictedClass;
 	}
 	const u32 attackTypesString = InternString(attackTypes);
+	// The groups gui/session plays on giving an order, as "name=path"
+	// tokens; Sound.js fills their {lang} and {phenotype} like select's.
+	std::string orderSounds;
+	for (const std::pair<const std::string, CParamNode>& group : templateNode->GetChild("Sound").GetChild("SoundGroups").GetChildren())
+		if (group.first.rfind("order_", 0) == 0 || group.first == "focus_fire" || group.first == "invalid_building_placement")
+			orderSounds += (orderSounds.empty() ? "" : " ") + group.first + "=" + group.second.ToString();
+	const u32 orderSoundsString = InternString(orderSounds);
 	// StrToLineCapType warns about anything but a cap name.
 	const auto lineCap = [&](const char* name) -> u8 {
 		const CParamNode& cap = rallyRenderer.GetChild(name);
@@ -1499,6 +1506,7 @@ void CSpeculaFeed::WriteTemplateDetails(CSimulation2& simulation, u32 index, con
 	m_Buffer.push_back(lineCap("LineEndCap"));
 	for (const u32 string : { supplyType, gatherRatesString, dropsiteTypes, attackTypesString })
 		PutU32(m_Buffer, string);
+	PutU32(m_Buffer, orderSoundsString);
 	EndRecord(m_Buffer, start);
 }
 
