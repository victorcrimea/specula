From 7655086d444367bbaedc70def3f87cafbc00ba50 Mon Sep 17 00:00:00 2001
From: Viktor Semenov <suit.uanic@gmail.com>
Date: Wed, 11 Nov 2026 09:33:07 +0000
Subject: [PATCH 28/45] Read Gaia's null hasSharedLos in the Specula feed
 without an error

Diplomacy.js's HasSharedLos returns null for a player with no
TechnologyManager, which Gaia is, and converting it to a bool raised a
JavaScript error every players record (every 5 turns). The feed now
reads it as truthy, as the session GUI does; the record is unchanged.
---
 source/network/SpeculaFeed.cpp | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/source/network/SpeculaFeed.cpp b/source/network/SpeculaFeed.cpp
index 64115d19d4..a57dd79bf5 100644
--- a/source/network/SpeculaFeed.cpp
+++ b/source/network/SpeculaFeed.cpp
@@ -2614,10 +2614,11 @@ void CSpeculaFeed::WritePlayers(CSimulation2& simulation)
 		std::string battle;
 		payload.push_back(battleState.isString() && Script::FromJSVal(rq, battleState, battle) && battle == "BATTLE" ? BATTLE_BATTLE : BATTLE_PEACE);
 		// The top panel shows a mutual ally's resources only to a player
-		// with shared LOS (CounterManager.js).
-		bool sharedLos = false;
-		Script::GetProperty(rq, player, "hasSharedLos", sharedLos);
-		payload.push_back(sharedLos ? 1 : 0);
+		// with shared LOS (CounterManager.js). Gaia, with no technology
+		// manager, has null (Diplomacy.js's HasSharedLos).
+		JS::RootedValue sharedLos(rq.cx);
+		Script::GetProperty(rq, player, "hasSharedLos", &sharedLos);
+		payload.push_back(Truthy(sharedLos) ? 1 : 0);
 	}
 	// The end rather than the time left, so the record changes only when
 	// a ceasefire starts or ends.
