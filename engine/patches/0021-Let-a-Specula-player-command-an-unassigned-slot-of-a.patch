 	if (g_Game && g_Game->IsGameStarted() && g_Game->GetTurnManager())
-		if (g_Game->GetTurnManager()->Update(DEFAULT_TURN_LENGTH, 1))
+		if (g_Game->GetTurnManager()->Update(frameLength, 1))
 			debug_printf("Turn %u (%u)...\n", turn++, DEFAULT_TURN_LENGTH);
 
+	// Specula: the play host's placement previews wait for no turn. A
+	// networked game's turn manager is the one CNetClient made.
+	if (g_NetClient && g_Game && g_Game->IsGameStarted() && g_Game->GetTurnManager())
+		static_cast<CNetClientTurnManager*>(g_Game->GetTurnManager())->AnswerSpeculaQueries();
