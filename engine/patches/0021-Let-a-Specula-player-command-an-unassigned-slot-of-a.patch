+void CSpeculaFeed::AnswerQueries(CSimulation2& simulation)
+{
+	ReadUplink();
+	if (m_Queries.empty())
+		return;
+
+	const ScriptInterface& scriptInterface = simulation.GetScriptInterface();
+	ScriptRequest rq(scriptInterface);
+	CmpPtr<ICmpTemplateManager> cmpTemplateManager(simulation, SYSTEM_ENTITY);
+	for (const SQuery& query : std::exchange(m_Queries, {}))
+	{
+		JS::RootedValue arg(rq.cx);
+		JS::RootedValue result(rq.cx);
+		if (!Script::ParseJSON(rq, query.json, &arg) || !arg.isObject())
+			LOGERROR("Specula feed: query %u is not a JSON object", query.id);
+		else if (query.method == QUERY_BUILDING_PREVIEW)
+			CallGui(simulation, query.player, L"SetBuildingPlacementPreview", arg, &result);
+		else if (query.method == QUERY_FOUNDATION_SNAP)
+		{
+			bool snapToEdges = false;
+			Script::GetProperty(rq, arg, "snapToEdges", snapToEdges);
+			if (snapToEdges)
+			{
+				float x = 0.0f;
+				float z = 0.0f;
+				Script::GetProperty(rq, arg, "x", x);
+				Script::GetProperty(rq, arg, "z", z);
+				JS::RootedValue edges(rq.cx, StaticEdgesNear(simulation, rq, entity_pos_t::FromFloat(x), entity_pos_t::FromFloat(z)));
+				Script::SetProperty(rq, arg, "snapToEdges", edges);
+			}
+			CallGui(simulation, query.player, L"GetFoundationSnapData", arg, &result);
+		}
+		else if (query.method == QUERY_WALL_PREVIEW)
+		{
+			std::string wallSetName;
+			Script::GetProperty(rq, arg, "wallSet", wallSetName);
+			JS::RootedValue dataArg(rq.cx);
+			JS::RootedValue data(rq.cx);
+			JS::RootedValue wallSet(rq.cx);
+			if (!wallSetName.empty())
+			{
+				Script::CreateObject(rq, &dataArg, "templateName", wallSetName, "player", query.player);
+				CallGui(simulation, query.player, L"GetTemplateData", dataArg, &data);
+			}
+			if (data.isObject())
+				Script::GetProperty(rq, data, "wallSet", &wallSet);
+			// SetWallPlacementPreview takes a missing wall set, as an empty
+			// name gives, as the end of the preview.
+			Script::SetProperty(rq, arg, "wallSet", wallSet);
+			CallGui(simulation, query.player, L"SetWallPlacementPreview", arg, &result);
+			JS::RootedValue pieces(rq.cx);
+			if (result.isObject() && cmpTemplateManager)
+				Script::GetProperty(rq, result, "pieces", &pieces);
+			for (u32 i = 0; i < ArrayLength(rq, pieces); ++i)
+			{
+				JS::RootedValue piece(rq.cx);
+				Script::GetPropertyInt(rq, pieces, static_cast<int>(i), &piece);
+				std::string pieceTemplate;
+				if (!piece.isObject() || !Script::GetProperty(rq, piece, "template", pieceTemplate))
+					continue;
+				Script::SetProperty(rq, piece, "actor", TemplateActor(cmpTemplateManager, pieceTemplate));
+			}
+		}
+
+		std::string json = result.isUndefined() ? std::string() : Script::StringifyJSON(rq, &result, false);
+		if (json.empty())
+			json = "null";
+		const size_t start = BeginRecord(m_Buffer, RECORD_QUERY_REPLY);
+		PutU32(m_Buffer, query.id);
+		m_Buffer.insert(m_Buffer.end(), json.begin(), json.end());
+		EndRecord(m_Buffer, start);
+	}
+	Send();
+}
+
+void CSpeculaFeed::ReadUplink()
+{
+	if (m_Socket < 0)
+		return;
+
+	u8 chunk[4096];
+	while (true)
+	{
+		const ssize_t result = recv(m_Socket, chunk, sizeof(chunk), MSG_DONTWAIT);
+		if (result < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			if (errno != EAGAIN && errno != EWOULDBLOCK)
+			{
+				Disable("recv");
+				return;
+			}
+			break;
+		}
+		// 0 is the encoder's end; the next send notices it.
+		if (result == 0)
+			break;
+		m_Inbox.insert(m_Inbox.end(), chunk, chunk + result);
+	}
+
+	size_t at = 0;
+	while (m_Inbox.size() - at >= 5)
+	{
+		const u8 kind = m_Inbox[at];
+		u32 length;
+		std::memcpy(&length, m_Inbox.data() + at + 1, sizeof(length));
+		if (length > UPLINK_MAX_RECORD)
+		{
+			errno = EPROTO;
+			Disable("uplink");
+			return;
+		}
+		if (m_Inbox.size() - at - 5 < length)
+			break;
+		const u8* payload = m_Inbox.data() + at + 5;
+		if (kind == UPLINK_COMMAND && length >= 1)
+			m_Commands.emplace_back(static_cast<i8>(payload[0]),
+				std::string(reinterpret_cast<const char*>(payload + 1), length - 1));
