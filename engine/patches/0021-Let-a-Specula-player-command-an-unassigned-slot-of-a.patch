+
+void CNetClientTurnManager::PostSpeculaCommands()
+{
+	const ScriptInterface& scriptInterface = m_Simulation2.GetScriptInterface();
+	ScriptRequest rq(scriptInterface);
+	for (const auto& [player, json] : m_SpeculaFeed->ReadCommands())
+	{
+		JS::RootedValue data(rq.cx);
+		if (!Script::ParseJSON(rq, json, &data) || !data.isObject())
+		{
+			LOGERROR("Specula feed: command for player %d is not a JSON object", player);
+			continue;
+		}
+		CSimulationMessage msg(scriptInterface, m_ClientId, player, m_CurrentTurn + m_CommandDelay, data);
+		m_NetClient.SendMessage(&msg);
+	}
 }
 
