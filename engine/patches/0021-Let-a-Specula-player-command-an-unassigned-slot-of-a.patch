new file mode 100644
index 0000000000..b6cc35d122
--- /dev/null
+++ b/binaries/data/mods/public/autostart/autostart_specula_play.js
@@ -0,0 +1,76 @@
+/**
+ * Specula: hosts a game for Specula's web players. The host itself only
+ * observes; the web players' slots stay unassigned and without AI, and
+ * the Specula feed posts their commands as the controller (see
+ * CNetClientTurnManager::PostSpeculaCommands). The game starts as soon as
+ * the host has joined its own server, without waiting for other clients.
+ */
+class AutoStartSpeculaPlay
+{
+	constructor(cmdLineArgs)
+	{
+		this.launched = false;
+		this.playerAssignments = {};
+		this.cmdLineArgs = cmdLineArgs;
+
+		try
+		{
+			const playerName = cmdLineArgs['autostart-playername'] || "specula";
+			const port = +(cmdLineArgs['autostart-port'] ?? 5073);
+			Engine.StartNetworkHost(playerName, port, "", false, !('autostart-disable-replay' in cmdLineArgs));
+		}
+		catch (e)
+		{
+			const message = sprintf(translate("Cannot host game: %(message)s."), { "message": e.message });
+			messageBox(400, 200, message, translate("Error"));
+		}
+	}
+
+	onTick()
+	{
+		while (true)
+		{
+			const message = Engine.PollNetworkClient();
+			if (!message)
+				break;
+
+			switch (message.type)
+			{
+			case "players":
+				// Unlike AutoStartHost, nobody is given a slot: the host
+				// stays an observer.
+				this.playerAssignments = message.newAssignments;
+				Engine.SendNetworkReady(2);
+				break;
+			case "ready":
+				if (this.playerAssignments[message.guid])
+					this.playerAssignments[message.guid].status = message.status;
+				break;
+			case "start":
+				return true;
+			default:
+			}
+		}
+
+		if (!this.launched && Object.keys(this.playerAssignments).length)
+			this.onLaunch();
+		return false;
+	}
+
+	onLaunch()
+	{
+		this.launched = true;
+
+		this.settings = new GameSettings().init();
+
+		// The player count comes from the map or -autostart-players, not
+		// from the clients, as the players are not clients.
+		parseCmdLineArgs(this.settings, this.cmdLineArgs);
+
+		this.settings.launchGame(this.playerAssignments, !('autostart-disable-replay' in this.cmdLineArgs));
+		Engine.SwitchGuiPage("page_loading.xml", {
+			"attribs": this.settings.finalizedAttributes,
+			"playerAssignments": this.playerAssignments
+		});
+	}
+}
