+	std::vector<u8> playerGui;
+	PutU32(playerGui, count);
+	for (u32 i = 0; i < count; ++i)
+	{
+		JS::RootedValue player(rq.cx);
+		JS::RootedValue prices(rq.cx);
+		JS::RootedValue buy(rq.cx);
+		JS::RootedValue sell(rq.cx);
+		Script::GetPropertyInt(rq, players, static_cast<int>(i), &player);
+		Script::GetProperty(rq, player, "barterPrices", &prices);
+		Script::GetProperty(rq, prices, "buy", &buy);
+		Script::GetProperty(rq, prices, "sell", &sell);
+
+		JS::RootedValue playerID(rq.cx);
+		std::vector<std::string> formations;
+		Script::ToJSVal(rq, &playerID, static_cast<i32>(i));
+		JS::RootedValue available(rq.cx);
+		cmpGuiInterface->ScriptCall(INVALID_PLAYER, L"GetAvailableFormations", playerID, &available);
+		Script::FromJSVal(rq, available, formations);
+		PutU16(playerGui, Clamp16(static_cast<u32>(formations.size())));
+		for (size_t j = 0; j < std::min<size_t>(formations.size(), 0xFFFF); ++j)
+		{
+			PutU32(playerGui, InternString(formations[j]));
+			WriteFormationData(simulation, rq, formations[j]);
+		}
+
+		std::vector<std::string> codes;
+		if (buy.isObject())
+			Script::EnumeratePropertyNames(rq, buy, true, codes);
+		std::sort(codes.begin(), codes.end());
+		codes.resize(std::min<size_t>(codes.size(), 0xFF));
+		playerGui.push_back(static_cast<u8>(codes.size()));
+		for (const std::string& code : codes)
+		{
+			PutU32(playerGui, InternString(code));
+			PutF32(playerGui, PropertyFloat(rq, buy, code.c_str()));
+			PutF32(playerGui, PropertyFloat(rq, sell, code.c_str()));
+		}
+	}
+	if (playerGui != m_LastPlayerGui)
+	{
+		const size_t guiStart = BeginRecord(m_Buffer, RECORD_PLAYER_GUI);
+		m_Buffer.insert(m_Buffer.end(), playerGui.begin(), playerGui.end());
+		EndRecord(m_Buffer, guiStart);
+		m_LastPlayerGui = std::move(playerGui);
+	}
