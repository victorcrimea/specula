+// As g_SelectionPanels.Upgrade's setupButton reads it for the owner: the
+// upgrade's own costs and requirements, with the limits of the template it
+// leads to. Its template data is sent as a trainable's is.
+void CSpeculaFeed::PutUpgrade(CSimulation2& simulation, const ScriptRequest& rq, player_id_t owner, JS::HandleValue upgrade, SProductionCache& cache, std::vector<u8>& out)
+{
+	JS::RootedValue entityValue(rq.cx);
+	Script::GetProperty(rq, upgrade, "entity", &entityValue);
+	const std::string templateName = StringOf(rq, entityValue);
+	std::vector<u8> ignored;
+	PutTrainable(simulation, rq, owner, templateName, cache, ignored);
+
+	JS::RootedValue arg(rq.cx);
+	JS::RootedValue data(rq.cx);
+	Script::CreateObject(rq, &arg, "templateName", templateName, "player", owner);
+	CallGui(simulation, owner, L"GetTemplateData", arg, &data);
+	if (!data.isObject())
+	{
+		PutProductionItem(InternString(templateName), PRODUCTION_HIDDEN, PRODUCTION_NO_LIMIT, {}, out);
+		return;
+	}
+	JS::RootedValue requirements(rq.cx);
+	JS::RootedValue requirementsArg(rq.cx);
+	JS::RootedValue met(rq.cx);
+	JS::RootedValue cost(rq.cx);
+	Script::GetProperty(rq, upgrade, "requirements", &requirements);
+	Script::GetProperty(rq, upgrade, "cost", &cost);
+	Script::CreateObject(rq, &requirementsArg, "requirements", requirements, "player", owner);
+	CallGui(simulation, owner, L"AreRequirementsMet", requirementsArg, &met);
+	PutProductionItem(InternString(templateName), Truthy(met) ? PRODUCTION_REQUIREMENTS_MET : 0,
+		LimitOf(CanBeAddedCount(simulation, rq, owner, templateName, data)), ResourceCosts(rq, cost), out);
+}
