+// What g_FormationsInfo holds for a formation: GetFormationInfoFromTemplate,
+// with the member count CanMoveEntsIntoFormation tests, so the client can
+// decide it for any selection.
+void CSpeculaFeed::WriteFormationData(CSimulation2& simulation, const ScriptRequest& rq, const std::string& formation)
+{
+	if (!m_FormationData.insert(formation).second)
+		return;
+	JS::RootedValue arg(rq.cx);
+	JS::RootedValue info(rq.cx);
+	Script::CreateObject(rq, &arg, "templateName", formation);
+	CallGui(simulation, INVALID_PLAYER, L"GetFormationInfoFromTemplate", arg, &info);
+	CmpPtr<ICmpTemplateManager> cmpTemplateManager(simulation, SYSTEM_ENTITY);
+	const CParamNode* templateNode = cmpTemplateManager ? cmpTemplateManager->GetTemplate(formation) : nullptr;
+	if (!info.isObject() || !templateNode)
+		return;
+	Script::SetProperty(rq, info, "minCount", NodeFloat(templateNode->GetChild("Formation").GetChild("RequiredMemberCount")));
+	const std::string json = Script::StringifyJSON(rq, &info, false);
+	const u32 name = InternString(formation);
+	const size_t start = BeginRecord(m_Buffer, RECORD_FORMATION_DATA);
+	PutU32(m_Buffer, name);
+	m_Buffer.insert(m_Buffer.end(), json.begin(), json.end());
+	EndRecord(m_Buffer, start);
+}
