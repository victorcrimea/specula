+// Only wall pieces have a control group other than their own id, so the
+// list is short; it is sorted so that an unchanged set compares equal.
+void CSpeculaFeed::WriteControlGroups(CSimulation2& simulation)
+{
+	std::vector<std::array<u32, 3>> groups;
+	for (const std::pair<const entity_id_t, IComponent*>& entry : simulation.GetEntitiesWithInterfaceUnordered(IID_Obstruction))
+	{
+		const ICmpObstruction* cmpObstruction = static_cast<const ICmpObstruction*>(entry.second);
+		const entity_id_t group = cmpObstruction->GetControlGroup();
+		const entity_id_t group2 = cmpObstruction->GetControlGroup2();
+		if (group != entry.first || group2 != INVALID_ENTITY)
+			groups.push_back({ static_cast<u32>(entry.first), static_cast<u32>(group), static_cast<u32>(group2) });
+	}
+	std::sort(groups.begin(), groups.end());
+	if (groups == m_LastControlGroups)
+		return;
+	m_LastControlGroups = groups;
+	const size_t start = BeginRecord(m_Buffer, RECORD_CONTROL_GROUPS);
+	PutU32(m_Buffer, static_cast<u32>(groups.size()));
+	for (const std::array<u32, 3>& entry : groups)
+		for (const u32 value : entry)
+			PutU32(m_Buffer, value);
+	EndRecord(m_Buffer, start);
+}
