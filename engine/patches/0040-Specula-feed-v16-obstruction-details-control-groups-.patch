+		if (obstruction.GetChild("Active").ToBool())
+			obstructionFlags |= OBSTRUCTION_ACTIVE;
+		if (obstruction.GetChild("Unit").IsOk())
+		{
+			obstructionType = 2;
+			obstructionWidth = obstruction.GetChild("Unit").GetChild("@radius").ToFixed().GetInternalValue();
+		}
+		else if (obstruction.GetChild("Static").IsOk())
+		{
+			obstructionType = 1;
+			obstructionWidth = obstruction.GetChild("Static").GetChild("@width").ToFixed().GetInternalValue();
+			obstructionDepth = obstruction.GetChild("Static").GetChild("@depth").ToFixed().GetInternalValue();
+		}
+		else
+		{
+			obstructionType = 3;
+			fixed maxX = fixed::Zero();
+			fixed maxZ = fixed::Zero();
+			fixed minX = fixed::Zero();
+			fixed minZ = fixed::Zero();
+			for (const std::pair<const std::string, CParamNode>& shapeNode : obstruction.GetChild("Obstructions").GetChildren())
+			{
+				const fixed width = shapeNode.second.GetChild("@width").ToFixed();
+				const fixed depth = shapeNode.second.GetChild("@depth").ToFixed();
+				const fixed dx = shapeNode.second.GetChild("@x").ToFixed();
+				const fixed dz = shapeNode.second.GetChild("@z").ToFixed();
+				clusterShapes.push_back({ dx.GetInternalValue(), dz.GetInternalValue(), width.GetInternalValue(), depth.GetInternalValue() });
+				maxX = std::max(maxX, dx + width / 2);
+				maxZ = std::max(maxZ, dz + depth / 2);
+				minX = std::min(minX, dx - width / 2);
+				minZ = std::min(minZ, dz - depth / 2);
+			}
+			obstructionWidth = fixed::FromInt(2).Multiply(std::max(maxX, -minX)).GetInternalValue();
+			obstructionDepth = fixed::FromInt(2).Multiply(std::max(maxZ, -minZ)).GetInternalValue();
+		}
