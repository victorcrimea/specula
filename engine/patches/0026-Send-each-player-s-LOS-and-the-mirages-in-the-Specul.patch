+// Each player's LOS as CLOSTexture reads it for the displayed player
+// (GetLosQuerier, so shared LOS and a revealed map are in it): what the
+// encoder blacks out, darkens and filters a player's view by.
+void CSpeculaFeed::WriteLos(CSimulation2& simulation)
+{
+	CmpPtr<ICmpRangeManager> cmpRangeManager(simulation, SYSTEM_ENTITY);
+	CmpPtr<ICmpPlayerManager> cmpPlayerManager(simulation, SYSTEM_ENTITY);
+	if (!cmpRangeManager || !cmpPlayerManager)
+		return;
+	const size_t side = cmpRangeManager->GetVerticesPerSide();
+	const player_id_t players = std::max<player_id_t>(0, std::min(cmpPlayerManager->GetNumPlayers() - 1, MAX_VISIBILITY_PLAYERS));
+	if (side != m_LosSide)
+	{
+		m_LastLos.clear();
+		m_LosSide = side;
+	}
+	m_LastLos.resize(players);
+
+	std::vector<u8> payload;
+	PutU32(payload, static_cast<u32>(side));
+	payload.push_back(static_cast<u8>(players));
+	bool changed = false;
+	std::vector<u8> state(side * side);
+	for (player_id_t player = 1; player <= players; ++player)
+	{
+		const CLosQuerier los = cmpRangeManager->GetLosQuerier(player);
+		for (size_t j = 0; j < side; ++j)
+			for (size_t i = 0; i < side; ++i)
+				state[j * side + i] =
+					(los.IsExplored_UncheckedRange(i, j) ? LOS_EXPLORED : 0) |
+					(los.IsVisible_UncheckedRange(i, j) ? LOS_VISIBLE : 0);
+
+		std::vector<u8>& last = m_LastLos[player - 1];
+		std::vector<std::pair<size_t, size_t>> runs;
+		if (last.size() != state.size())
+			runs.emplace_back(0, state.size());
+		else
+			for (size_t k = 0; k < state.size(); ++k)
+			{
+				if (state[k] == last[k])
+					continue;
+				if (!runs.empty() && k - runs.back().second <= LOS_RUN_GAP)
+					runs.back().second = k + 1;
+				else
+					runs.emplace_back(k, k + 1);
+			}
+		PutU32(payload, static_cast<u32>(runs.size()));
+		for (const std::pair<size_t, size_t>& run : runs)
+		{
+			PutU32(payload, static_cast<u32>(run.first));
+			PutU32(payload, static_cast<u32>(run.second - run.first));
+			for (size_t k = run.first; k < run.second; k += 4)
+			{
+				u8 packed = 0;
+				for (size_t m = 0; m < 4 && k + m < run.second; ++m)
+					packed |= static_cast<u8>(state[k + m] << (2 * m));
+				payload.push_back(packed);
+			}
+		}
+		changed = changed || !runs.empty();
+		last.swap(state);
+		state.resize(side * side);
+	}
+	if (!changed)
+		return;
+	const size_t start = BeginRecord(m_Buffer, RECORD_LOS);
+	m_Buffer.insert(m_Buffer.end(), payload.begin(), payload.end());
+	EndRecord(m_Buffer, start);
+}
