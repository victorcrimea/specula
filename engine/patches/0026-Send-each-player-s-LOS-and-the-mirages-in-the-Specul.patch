+// The groups of the components Fogging.js copies into a mirage, whose
+// copies answer the same getters (the *Mirage classes); false for any other
+// interface.
+bool CSpeculaFeed::PutMiragedGroup(const ScriptRequest& rq, std::string_view interface, JS::HandleValue component, SDetailGroups& groups)
+{
+	if (interface == "Health")
+	{
+		std::vector<u8>& group = groups[DETAIL_HEALTH];
+		PutF32(group, CallFloat(rq, component, "GetHitpoints"));
+		PutF32(group, CallFloat(rq, component, "GetMaxHitpoints"));
+	}
+	else if (interface == "Capturable")
+	{
+		JS::RootedValue points(rq.cx);
+		ScriptFunction::Call(rq, component, "GetCapturePoints", &points);
+		const u32 count = std::min<u32>(ArrayLength(rq, points), 0xFF);
+		std::vector<u8>& group = groups[DETAIL_CAPTURE];
+		group.push_back(static_cast<u8>(count));
+		for (u32 j = 0; j < count; ++j)
+		{
+			double value = 0.0;
+			Script::GetPropertyInt(rq, points, static_cast<int>(j), value);
+			PutF32(group, static_cast<float>(value));
+		}
+		PutF32(group, CallFloat(rq, component, "GetMaxCapturePoints"));
+	}
+	else if (interface == "ResourceSupply")
+	{
+		PutF32(groups[DETAIL_SUPPLY], CallFloat(rq, component, "GetCurrentAmount"));
+		PutF32(groups[DETAIL_SUPPLY], CallFloat(rq, component, "GetMaxAmount"));
+		groups[DETAIL_GATHERERS].push_back(Clamp8(static_cast<u32>(CallFloat(rq, component, "GetNumGatherers"))));
+		groups[DETAIL_GATHERERS].push_back(Clamp8(static_cast<u32>(CallFloat(rq, component, "GetMaxGatherers"))));
+	}
+	else if (interface == "Foundation" || interface == "Repairable")
+	{
+		JS::RootedValue buildTime(rq.cx);
+		ScriptFunction::Call(rq, component, "GetBuildTime", &buildTime);
+		std::vector<u8>& group = groups[interface == "Foundation" ? DETAIL_FOUNDATION : DETAIL_REPAIR];
+		group.push_back(Clamp8(static_cast<u32>(CallFloat(rq, component, "GetNumBuilders"))));
+		PutF32(group, PropertyFloat(rq, buildTime, "timeRemaining"));
+	}
+	else
+		return false;
+	return true;
+}
